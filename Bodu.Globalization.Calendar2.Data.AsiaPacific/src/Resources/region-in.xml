      <Rules><Rule id="in"><Applicability fromYear="1583"><Territory code="IN" /></Applicability><Strategy><OffsetFromRule notableDateRef="easter-sunday" ruleRef="in" offsetDays="-2" /></Strategy></Rule></Rules>
