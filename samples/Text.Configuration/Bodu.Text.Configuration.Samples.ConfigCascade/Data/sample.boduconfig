# Build/formatting configuration (sample data), EditorConfig-style cascade.
root = true

[*]
indent_size = 4
max_line_length = 120
start_day = Monday
strict_nullability = true

[src/**.cs]
# Production code is held to the tighter limit.
indent_size = 8
max_line_length = 100

[test/**.cs]
# Test code may run long lines; the limit is unset here.
max_line_length = unset
