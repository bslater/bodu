<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bodu.Globalization.Calendar.Samples.Plugin.Contoso</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- Sample code - opt out of the shipping-library style gates. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzers>false</RunAnalyzers>
    <BoduCodeStyleAnalyzers>false</BoduCodeStyleAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <!-- A plugin needs only the contracts: the algorithm interface and the plugin interface.
         It does not reference the host, and the host does not reference its types. -->
    <ProjectReference Include="..\..\..\Bodu.Globalization.Calendar\src\Bodu.Globalization.Calendar.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Globalization.Calendar.Plugins\src\Bodu.Globalization.Calendar.Plugins.csproj" />
  </ItemGroup>

</Project>
