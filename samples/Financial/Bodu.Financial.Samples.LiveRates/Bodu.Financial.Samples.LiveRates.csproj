<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bodu.Financial.Samples.LiveRates</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- Sample code - opt out of the shipping-library style gates. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzers>false</RunAnalyzers>
    <BoduCodeStyleAnalyzers>false</BoduCodeStyleAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <!--
      All eleven provider packages are referenced so switching the active provider in Program.cs
      is a comment flip, not a project edit. NuGet consumers add only the package they use.
    -->
    <ProjectReference Include="..\..\..\Bodu.Financial\src\Bodu.Financial.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates\src\Bodu.Financial.ExchangeRates.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Ecb\src\Bodu.Financial.ExchangeRates.Ecb.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Rba\src\Bodu.Financial.ExchangeRates.Rba.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Boe\src\Bodu.Financial.ExchangeRates.Boe.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Yahoo\src\Bodu.Financial.ExchangeRates.Yahoo.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Ofx\src\Bodu.Financial.ExchangeRates.Ofx.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Oanda\src\Bodu.Financial.ExchangeRates.Oanda.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Xe\src\Bodu.Financial.ExchangeRates.Xe.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Fixer\src\Bodu.Financial.ExchangeRates.Fixer.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.ExchangeRateHost\src\Bodu.Financial.ExchangeRates.ExchangeRateHost.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Fred\src\Bodu.Financial.ExchangeRates.Fred.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Imf\src\Bodu.Financial.ExchangeRates.Imf.csproj" />
  </ItemGroup>

</Project>
