<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(BoduNetTargets)</TargetFrameworks>
    <RootNamespace>Bodu.Financial.Samples.CachedRates</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- Sample code - opt out of the shipping-library style gates. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzers>false</RunAnalyzers>
    <BoduCodeStyleAnalyzers>false</BoduCodeStyleAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- MemoryDistributedCache: an in-process IDistributedCache, so the distributed backend runs offline. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Bodu.Financial\src\Bodu.Financial.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Caching\src\Bodu.Financial.ExchangeRates.Caching.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Caching.Distributed\src\Bodu.Financial.ExchangeRates.Caching.Distributed.csproj" />
    <ProjectReference Include="..\..\..\Bodu.Financial.ExchangeRates.Caching.Sqlite\src\Bodu.Financial.ExchangeRates.Caching.Sqlite.csproj" />
  </ItemGroup>

</Project>
