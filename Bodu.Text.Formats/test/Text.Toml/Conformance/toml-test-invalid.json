 = 1, k1.name = \"joe\"}\n"},{"name":"table/append-with-dotted-keys-08","toml":"[a.b.c]\nz = 9\n\n[[totally_unrelated]]\nx = 123\n\n[a]\nb.c.t = \"this should NOT be allowed\"\n"},{"name":"table/array-empty","toml":"[[]]\nname = \"Born to Run\"\n"},{"name":"table/array-implicit","toml":"# This test is a bit tricky. It should fail because the first use of\n# `[[albums.songs]]` without first declaring `albums` implies that `albums`\n# must be a table. The alternative would be quite weird. Namely, it wouldn't\n# comply with the TOML spec: \"Each double-bracketed sub-table will belong to \n# the most *recently* defined table element *above* it.\"\n#\n# This is in contrast to the *valid* test, table-array-implicit where\n# `[[albums.songs]]` works by itself, so long as `[[albums]]` isn't declared\n# later. (Although, `[albums]` could be.)\n[[albums.songs]]\nname = \"Glory Days\"\n\n[[albums]]\nname = \"Born in the USA\"\n"},{"name":"table/array-no-close-01","toml":"[[albums]\nname = \"Born to Run\"\n"},{"name":"table/array-no-close-02","toml":"[[closing-bracket.missing]\nblaa=2\n"},{"name":"table/array-no-close-03","toml":"[[a\n[[b]]\n"},{"name":"table/array-no-close-04","toml":"[[a\nb = 2\n"},{"name":"table/bare-invalid-character-01","toml":"[!]\nk = 123\n"},{"name":"table/bare-invalid-character-02","toml":"[bare!key]\nk = 123\n"},{"name":"table/dot","toml":"[.]\nk = 1\n"},{"name":"table/dotdot","toml":"[..]\nk = 1\n"},{"name":"table/duplicate-key-01","toml":"[a]\nb = 1\n\n[a]\nc = 2\n"},{"name":"table/duplicate-key-02","toml":"[fruit]\ntype = \"apple\"\n\n[fruit.type]\napple = \"yes\"\n"},{"name":"table/duplicate-key-03","toml":"[fruit]\napple.color = \"red\"\n\n[[fruit.apple]]\n"},{"name":"table/duplicate-key-04","toml":"[fruit]\napple.color = \"red\"\n\n[fruit.apple] # INVALID\n"},{"name":"table/duplicate-key-05","toml":"[fruit]\napple.taste.sweet = true\n\n[fruit.apple.taste] # INVALID\n"},{"name":"table/duplicate-key-06","toml":"[tbl]\n[[tbl]]\n"},{"name":"table/duplicate-key-07","toml":"[[tbl]]\n[tbl]\n"},{"name":"table/duplicate-key-08","toml":"[a]\nb = { c = 2, d = {} }\n[a.b]\nc = 2\n"},{"name":"table/duplicate-key-09","toml":"[a]\nfoo=\"bar\"\n[a.b]\nfoo=\"bar\"\n[a]\n"},{"name":"table/duplicate-key-10","toml":"a = []\n[[a.b]]\n"},{"name":"table/empty","toml":"[]\n"},{"name":"table/empty-implicit-table","toml":"[naughty..naughty]\n"},{"name":"table/equals-sign","toml":"[name=bad]\n"},{"name":"table/llbrace","toml":"[ [table]]\n"},{"name":"table/multiline-key-01","toml":"[\"\"\"tbl\"\"\"]\nk = 1\n"},{"name":"table/multiline-key-02","toml":"['''tbl''']\nk = 1\n"},{"name":"table/nested-brackets-close","toml":"[a]b]\nzyx = 42\n"},{"name":"table/nested-brackets-open","toml":"[a[b]\nzyx = 42\n"},{"name":"table/newline-01","toml":"[tbl\n]\nk = 1\n"},{"name":"table/newline-02","toml":"[\"tbl\n\"]\nk = 1\n"},{"name":"table/newline-03","toml":"[\"tbl\"\n]\nk = 1\n"},{"name":"table/newline-04","toml":"[tbl.\n]\nk = 1\n"},{"name":"table/newline-05","toml":"[tbl\n.sub]\nk = 1\n"},{"name":"table/no-close-01","toml":"[where will it end\nname = value\n\n"},{"name":"table/no-close-02","toml":"[closing-bracket.missingö\nblaa=2\n"},{"name":"table/no-close-03","toml":"[\"where will it end]\nname = value\n\n"},{"name":"table/no-close-04","toml":"[\n"},{"name":"table/no-close-05","toml":"[fwfw.wafw\n"},{"name":"table/no-close-06","toml":"[a\n[b]\n[c\n[d]\n"},{"name":"table/no-close-07","toml":"[']\n"},{"name":"table/no-close-08","toml":"[''']\n"},{"name":"table/no-close-09","toml":"[\"where will it end\"\"]\nname = value\n"},{"name":"table/overwrite-array-in-parent","toml":"[[parent-table.arr]]\n[parent-table]\nnot-arr = 1\narr = 2\n"},{"name":"table/overwrite-bool-with-array","toml":"a=true\n[[a]]\n"},{"name":"table/overwrite-with-deep-table","toml":"a=1\n[a.b.c.d]\n"},{"name":"table/redefine-01","toml":"# Define b as int, and try to use it as a table: error\n[a]\nb = 1\n\n[a.b]\nc = 2\n"},{"name":"table/redefine-02","toml":"[t1]\nt2.t3.v = 