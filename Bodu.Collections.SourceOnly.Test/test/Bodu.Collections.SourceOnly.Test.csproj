<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dedicated test assembly that compiles Bodu.Collections/shared/** FROM SOURCE and holds it to the
    published RFC 6962 vectors, with no reference to Bodu.Collections at all.

    The shared folder exists so that an assembly which must not take a package dependency can still use the
    RFC 6962 primitives, the way Bodu.IO.Pst source-compiles Bodu.IO.Hashing/shared/CrcCore.cs. That claim is
    easy to break silently: adding a resx lookup, a helper from the owning project, or any type outside
    Bodu.Core to the shared source would keep the owning package building while quietly making the files
    uncompilable anywhere else. This project fails the build the moment that happens.

    It also exercises the namespace switch. SECURITY_CRYPTOGRAPHY is the symbol Bodu.Security.Cryptography
    itself defines, so the shared files land in that namespace here too - which is why the test file below
    imports Bodu.Security.Cryptography despite guarding the Merkle source, and why nothing here collides with
    the real Bodu.Collections.Generic Merkle types.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bodu</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Namespace selector for the shared source compiled in below. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);SECURITY_CRYPTOGRAPHY</DefineConstants>
  </PropertyGroup>

  <!--
    Deliberately NOT a ProjectReference to Bodu.Collections. Bodu.Core is the only production dependency the
    shared source is allowed, and adding any other reference here would defeat the guard.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Bodu.Core\src\Bodu.Core.csproj" />
    <ProjectReference Include="..\..\Bodu.Test\test\Bodu.Test.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Bodu.Collections\shared\**\*.cs"
             Link="shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
