<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(BoduNetTargets)</TargetFrameworks>
    <RootNamespace>Bodu</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bodu.Test\test\Bodu.Test.csproj" />
    <ProjectReference Include="..\src\Bodu.Formats.Outlook.Msg.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures\Reference\valid\*.msg">
      <LogicalName>Bodu.Formats.Outlook.Msg.Fixtures.Reference.valid.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Fixtures\Reference\invalid\*.msg">
      <LogicalName>Bodu.Formats.Outlook.Msg.Fixtures.Reference.invalid.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Fixtures\Reference\manifest.json">
      <LogicalName>Bodu.Formats.Outlook.Msg.Fixtures.Reference.manifest.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Byte-identical copies of corpus/msg/fixes/*-fixes.csv, the release-note fix catalogue the corpus tests run. -->
    <EmbeddedResource Include="Fixtures\ReleaseNotes\*-fixes.csv">
      <LogicalName>Bodu.Formats.Outlook.Msg.Fixtures.ReleaseNotes.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
