<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bodu</RootNamespace>
    <AssemblyName>Bodu.CodeStyle.XmlDocumentation.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      System.Collections.Immutable is part of the Roslyn analyzer host's assembly set, so it is safe to use at
      analyzer runtime. System.Text.Json is intentionally NOT referenced: it is not guaranteed in every analyzer
      host, so configuration JSON is parsed by the dependency-free ConfigJsonParser instead. This keeps the
      analyzer package self-contained (only the three Bodu assemblies need to ship).
    -->
    <PackageReference Include="System.Collections.Immutable" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="XmlDocResourceStrings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>XmlDocResourceStrings.Designer.cs</LastGenOutput>
      <!-- RootNamespace is Bodu; pin the manifest name the generated Designer accessor expects. -->
      <LogicalName>Bodu.CodeStyle.XmlDocumentation.XmlDocResourceStrings.resources</LogicalName>
    </EmbeddedResource>
    <Compile Update="XmlDocResourceStrings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>XmlDocResourceStrings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bodu.CodeStyle.XmlDocumentation.Core.Test" />
    <InternalsVisibleTo Include="Bodu.CodeStyle.XmlDocumentation.Analyzers" />
    <InternalsVisibleTo Include="Bodu.CodeStyle.XmlDocumentation.Analyzers.Test" />
    <InternalsVisibleTo Include="Bodu.CodeStyle.XmlDocumentation.CodeFixes" />
    <InternalsVisibleTo Include="Bodu.CodeStyle.XmlDocumentation.CodeFixes.Test" />
  </ItemGroup>

</Project>
