{
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [ "**/src/*.csproj" ],
          "exclude": [ "Bodu.CodeStyle/**" ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "memberLayout": "separatePages",
      "enumSortOrder": "declaringOrder",
      "globalNamespaceId": "global",
      "disableDefaultFilter": false,
      "properties": {
        "TargetFramework": "net8.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.{md,yml}" ],
        "exclude": [ "_site/**", "templates/**", "apidoc/**" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ]
      }
    ],
    "overwrite": [
      {
        "files": [ "apidoc/**.md" ],
        "exclude": [ "_site/**" ]
      }
    ],
    "dest": "_site",
    "template": [ "default", "templates/darkerfx" ],
    "markdownEngineName": "markdig",
    "xrefService": [
      "https://xref.docs.microsoft.com/query?uid={uid}"
    ],
    "keepFileLink": false,
    "noLangKeyword": false,
    "disableGitFeatures": true,
    "globalMetadata": {
      "_appName": "BODU",
      "_appTitle": "BODU",
      "_enableSearch": true,
      "pdf": false,
      "_disableContribution": true,
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.svg",
      "_appFooter": "Documentation © 2026 Bodu contributors · Licensed under the MIT licence · Generated by <strong>DocFX</strong>"
    }
  }
}
