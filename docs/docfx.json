{
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [
            "Bodu.*/src/bin/Release/net10.0/Bodu.*.dll"
          ],
          "exclude": [
            "Bodu.CodeStyle/**",
            "Bodu.Text.Formats.Generators/**",
            "Bodu.Globalization.Calendar.Build/**",
            "archive/**",
            "**/ref/**",
            "**/refint/**"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "memberLayout": "samePage",
      "namespaceLayout": "nested",
      "enumSortOrder": "declaringOrder",
      "globalNamespaceId": "global",
      "disableDefaultFilter": false
    }
  ],

  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "templates/**",
          "apidoc/**",
          "reviews/**",
          "forensic-review/**"
        ]
      }
    ],

    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],

    "overwrite": [
      {
        "files": [
          "apidoc/**/*.md"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],

    "dest": "_site",

    "template": [
      "default",
      "modern"
    ],

    "markdownEngineName": "markdig",

    "xrefService": [
      "https://xref.docs.microsoft.com/query?uid={uid}"
    ],

    "keepFileLink": false,
    "noLangKeyword": false,
    "disableGitFeatures": false,

    "globalMetadata": {
      "_appName": "BODU",
      "_appTitle": "BODU",
      "_enableSearch": true,
      "pdf": false,
      "_disableContribution": true,
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.svg",
      "_appFooter": "Documentation © 2026 Bodu contributors · Licensed under the MIT licence · Generated by <strong>DocFX</strong>"
    }
  }
}
