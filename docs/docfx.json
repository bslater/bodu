{
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**",
          "templates/**",
          "apidoc/**",
          "reviews/**",
          "forensic-review/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "apidoc/**/*.md"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern",
      "templates/bodu"
    ],
    "markdownEngineName": "markdig",
    "xrefService": [
      "https://xref.docs.microsoft.com/query?uid={uid}"
    ],
    "keepFileLink": false,
    "noLangKeyword": false,
    "disableGitFeatures": false,
    "globalMetadata": {
      "_appName": "BODU",
      "_appTitle": "BODU",
      "_enableSearch": true,
      "pdf": false,
      "_disableContribution": true,
      "_appLogoPath": "images/favicon.svg",
      "_appFaviconPath": "images/favicon.svg",
      "_appFooter": "Documentation © 2026 Bodu contributors · Licensed under the MIT licence · Generated by <strong>DocFX</strong>",
      "_boduNuGetPackageUrl": "https://www.nuget.org/packages/"
    },
    "globalMetadataFiles": [
      "obj/api/frameworks.json"
    ]
  }
}
