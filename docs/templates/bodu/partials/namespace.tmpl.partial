{{!Bodu: the packages the namespace's types ship in, and an availability badge on each type that exists in fewer frameworks than the namespace.}}

<h1 id="{{id}}" data-uid="{{uid}}" class="text-break" data-bodu-frameworks="{{boduFrameworksAttr}}">{{>partials/title}}</h1>
{{>partials/bodu.frameworkState}}
{{#boduPackages.0}}
<div class="facts text-secondary">
  <dl class="bodu-package"><dt>{{boduPackagesLabel}}</dt><dd>
{{/boduPackages.0}}
{{#boduPackages}}
    <div>{{>partials/bodu.package}}</div>
{{/boduPackages}}
{{#boduPackages.0}}
  </dd></dl>
</div>
{{/boduPackages.0}}
<div class="markdown level0 summary">{{{summary}}}</div>
<div class="markdown level0 conceptual">{{{conceptual}}}</div>
<div class="markdown level0 remarks">{{{remarks}}}</div>

{{#children}}
  <h3 id="{{id}}">{{>partials/namespaceSubtitle}}</h3>
  {{#children}}
  <dl class="jumplist" data-bodu-frameworks="{{boduFrameworksAttr}}">
    <dt><xref uid="{{uid}}" altProperty="fullName" displayProperty="name"/>{{#boduAvailability}} <span class="badge bodu-availability">{{boduAvailability}}</span>{{/boduAvailability}}</dt>
    <dd>{{{summary}}}</dd>
  </dl>
  {{/children}}
{{/children}}
