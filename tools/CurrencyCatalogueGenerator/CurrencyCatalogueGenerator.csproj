<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(BoduNetTargets)</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bodu.Tools.CurrencyCatalogueGenerator</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="CurrencyCatalogueGeneratorResourceStrings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>CurrencyCatalogueGeneratorResourceStrings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="CurrencyCatalogueGeneratorResourceStrings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CurrencyCatalogueGeneratorResourceStrings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
