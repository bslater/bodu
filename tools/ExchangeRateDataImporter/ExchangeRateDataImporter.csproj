<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bodu.Tools.ExchangeRateDataImporter</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Reuse the production TOML cache writer so emitted files match what the provider reads. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Bodu.Financial.ExchangeRates.Caching\src\Bodu.Financial.ExchangeRates.Caching.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="ExchangeRateDataImporterResourceStrings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ExchangeRateDataImporterResourceStrings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="ExchangeRateDataImporterResourceStrings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ExchangeRateDataImporterResourceStrings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
