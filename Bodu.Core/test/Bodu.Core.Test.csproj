<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bodu</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      Test data factories ([DynamicData] sources, exception-throwing test scaffolds, optional-selector
      EnumerableTestPlan constructors) deliberately pass null where the production type is non-nullable.
      Suppress the corresponding nullable-context warnings project-wide rather than annotating every site;
      production code in Bodu.Core/src retains full nullable analysis via its own csproj settings.
    -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <!-- Exclude files that are incompatible with netstandard2.0 -->
  <ItemGroup>
    <!--
      Static-import ExceptionAssert so the unqualified AssertGuard(...) calls in the existing
      ThrowHelperTests partial-class files continue to resolve after the private partial helper was
      promoted to Bodu.Test in PR 1. Lets the shim file be deleted without touching every call site.
    -->
    <Using Include="Bodu.Test.Assertions.ExceptionAssert" Static="true" />
    <!-- Shared test-double namespaces promoted to Bodu.Test; imported project-wide so the doubles resolve unqualified. -->
    <Using Include="Bodu.Test.Collections" />
    <Using Include="Bodu.Test.Comparers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Bodu.Core.csproj" />
    <ProjectReference Include="..\..\Bodu.Test\test\Bodu.Test.csproj" />
  </ItemGroup>
</Project>
