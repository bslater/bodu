<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SharpFuzz harness for the Bodu YAML parser. This is an internal fuzzing tool, not a shipping library and
    not a test project: it is deliberately NOT listed in bodu.slnx, so the `dotnet test` tiers never pick it
    up. Build and run it through bld/run-yaml-fuzz.sh. See Bodu.Text.Yaml/README.md (Fuzzing).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bodu.Text.Yaml.Fuzzing</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Internal fuzzing tool - opt out of the shipping-library style gates. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Bodu.Text.Yaml.csproj" />
  </ItemGroup>

</Project>
