<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bodu</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bodu.Test\test\Bodu.Test.csproj" />
    <ProjectReference Include="..\src\Bodu.Text.Yaml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Bodu profile classification manifest (kept in-repo), copied to the output for the Regression-tier suite. -->
    <None Include="YamlTestCorpus\**" CopyToOutputDirectory="PreserveNewest" />

    <!-- The yaml/yaml-test-suite conformance corpus, linked as the 'yaml-test-suite' git submodule and copied to the
         output. Initialize the submodule (git submodule update, init flag) to populate it before the Regression tier. -->
    <None Include="yaml-test-suite\**\*"
          Exclude="yaml-test-suite\.git;yaml-test-suite\.git\**;yaml-test-suite\.github\**;yaml-test-suite\name\**;yaml-test-suite\tags\**"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
