<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(BoduNetTargets)</TargetFrameworks>
    <RootNamespace>Bodu</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bodu.Test\test\Bodu.Test.csproj" />
    <ProjectReference Include="..\src\Bodu.Text.Yaml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The yaml/yaml-test-suite conformance corpus, linked as the 'yaml-test-suite' git submodule and copied to the
         output. Each case is classified in code by YamlTestCorpusReader. Initialize the submodule (git submodule
         update, init flag) to populate it before the Regression tier. -->
    <None Include="yaml-test-suite\**\*"
          Exclude="yaml-test-suite\.git;yaml-test-suite\.git\**;yaml-test-suite\.github\**;yaml-test-suite\name\**;yaml-test-suite\tags\**"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Byte-for-byte copies of the release-note fix catalogues in corpus/yaml/fixes, run by
         YamlReleaseNoteCorpusTests; its governance tests hold the copies to their sources. -->
    <EmbeddedResource Include="Fixtures\ReleaseNotes\*-fixes.csv" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copies of the line formats' shared sources (Bodu.Text.Serialization/flat/src), from which the SharedSources
         tests read every type this package must not compile. -->
    <EmbeddedResource Include="..\..\Bodu.Text.Serialization\flat\src\*.cs"
                      LogicalName="LineFormatSharedSources/%(Filename)%(Extension)"
                      Link="LineFormatSharedSources\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
