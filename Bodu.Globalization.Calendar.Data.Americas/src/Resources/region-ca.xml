<?xml version="1.0" encoding="utf-8"?>
<!--
  Canadian notable-date resource using the Western/Gregorian calendar.

  These entries represent Canadian federal statutory holidays and widely observed
  provincial and cultural dates. National rules use territory="CA"; province-specific
  rules use their ISO 3166-2 subdivision codes (CA-AB, CA-BC, CA-MB, CA-NB, CA-NL,
  CA-NS, CA-NT, CA-NU, CA-ON, CA-PE, CA-QC, CA-SK, CA-YT).

  Note on Victoria Day: Victoria Day falls on the Monday immediately preceding
  25 May (Canada Holidays Act, RSC 1985 c H-5.1) — that is, the Monday on or
  before 24 May. It is expressed declaratively with the WeekdayNearDate
  strategy and needs no custom algorithm.

  Country-specific rules explicitly import only the inherited global and Christian
  dates that Canada observes, and override naming, territory, nonWorking, adjustment,
  or tagging behavior where required.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!--
    Imported global observances.
  -->

  <UseFrom resource="./global-all.xml">
    <Use name="New Year's Day" territory="CA" nonWorking="true" />
    <Use name="Valentine's Day" territory="CA" />
    <Use name="International Women's Day" territory="CA" />
    <Use name="Halloween" territory="CA" />
    <Use name="Remembrance Day" territory="CA" nonWorking="true">
      <Rule name="fixed-nov-11-weekend-roll-ca" category="Holiday" nonWorking="true">
        <Adjustment key="weekend-roll" when="IfWeekend" action="MoveToNextWeekday" />
      </Rule>
    </Use>
  </UseFrom>

  <!--
    Imported Christian observances.
  -->

  <UseFrom resource="./christian-gregorian.xml">
    <Use name="Good Friday" territory="CA" nonWorking="true" />
    <Use name="Easter Sunday" territory="CA" />
    <Use name="Easter Monday" territory="CA" nonWorking="true" />
    <Use name="Christmas Eve" territory="CA" />
    <Use name="Christmas Day" territory="CA" nonWorking="true">
      <Rule name="fixed-dec-25-nonworking-roll-ca" category="Holiday" nonWorking="true">
        <Adjustment key="weekend-roll" when="IfNonWorkingDay" action="MoveToNextWorkingDay" />
      </Rule>
    </Use>
  </UseFrom>

  <!--
    Imported family observances.
  -->

  <UseFrom resource="./global-family.xml">
    <Use name="Mother's Day" territory="CA" />
    <Use name="Father's Day" territory="CA" />
  </UseFrom>

  <!--
    National Canadian holidays and observances.
  -->

  <NotableDate name="Victoria Day">
    <Rule name="weekday-mon-onorbefore-may-24-ca" category="Holiday" territory="CA" nonWorking="true"
          comment="Victoria Day falls on the Monday immediately preceding 25 May (Canada Holidays Act, RSC 1985 c H-5.1) — that is, the Monday on or before 24 May.">
      <WeekdayNearDate dayOfWeek="Monday" month="May" day="24" direction="OnOrBefore" />
      <Tag>FederalHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Canada Day">
    <Rule name="fixed-jul-01-weekend-roll-ca" category="Holiday" territory="CA" nonWorking="true"
          comment="When 1 July falls on a Sunday, the following Monday is observed as the statutory holiday (Canada Holidays Act). No substitute day is designated when 1 July falls on a Saturday.">
      <Fixed month="July" day="1" />
      <Tag>FederalHoliday</Tag>
      <Adjustment key="weekend-roll" when="IfWeekend" action="MoveToNextWeekday" />
    </Rule>
  </NotableDate>

  <NotableDate name="Labour Day">
    <Rule name="weekday-1st-mon-sep-ca" category="Holiday" territory="CA" nonWorking="true">
      <DayOfWeekInMonth month="September" dayOfWeek="Monday" weekOrdinal="First" />
      <Tag>FederalHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="National Day for Truth and Reconciliation">
    <Rule name="fixed-sep-30-weekend-roll-ca"
          category="Holiday"
          territory="CA"
          nonWorking="true"
          firstYear="2021"
          comment="Established by the National Council for Reconciliation Act (Bill C-8, 2021) in response to Call to Action 80 of the Truth and Reconciliation Commission of Canada. First observed on 30 September 2021.">
      <Fixed month="September" day="30" />
      <Tag>FederalHoliday</Tag>
      <Adjustment key="weekend-roll" when="IfWeekend" action="MoveToNextWeekday" />
    </Rule>
  </NotableDate>

  <NotableDate name="Thanksgiving">
    <Rule name="weekday-2nd-mon-oct-ca" category="Holiday" territory="CA" nonWorking="true">
      <DayOfWeekInMonth month="October" dayOfWeek="Monday" weekOrdinal="Second" />
      <Tag>FederalHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Boxing Day">
    <Rule name="fixed-dec-26-nonworking-roll-ca" category="Holiday" territory="CA" nonWorking="true"
          comment="A federal statutory holiday. Also a provincial holiday in Ontario and New Brunswick.">
      <Fixed month="December" day="26" />
      <Tag>FederalHoliday</Tag>
      <Adjustment key="weekend-roll" when="IfNonWorkingDay" action="MoveToNextWorkingDay" />
    </Rule>
  </NotableDate>

  <!--
    Widely observed Canadian cultural and family observances.
  -->

  <NotableDate name="National Indigenous Peoples Day">
    <Rule name="fixed-jun-21-ca" category="Observance" territory="CA" firstYear="1996"
          comment="Proclaimed by Governor General Roméo LeBlanc in 1996 on the recommendation of the Royal Commission on Aboriginal Peoples, in recognition of the unique heritage, diverse cultures, and outstanding contributions of Indigenous peoples.">
      <Fixed month="June" day="21" />
    </Rule>
  </NotableDate>

  <!--
    Province-specific Family Day and equivalent observances (Third Monday February).

    Each province enacted its own legislation under a different name on a different
    year; all happen to fall on the third Monday of February.
  -->

  <NotableDate name="Family Day">
    <Rule name="weekday-3rd-mon-feb-ca-ab"
          category="Holiday"
          territory="CA-AB"
          nonWorking="true"
          firstYear="1990"
          comment="Introduced in Alberta by the Family Day Act, first observed on the third Monday of February 1990.">
      <DayOfWeekInMonth month="February" dayOfWeek="Monday" weekOrdinal="Third" />
      <Tag>ProvinceHoliday</Tag>
    </Rule>
    <Rule name="weekday-3rd-mon-feb-ca-sk"
          category="Holiday"
          territory="CA-SK"
          nonWorking="true"
          firstYear="2007"
          comment="Introduced in Saskatchewan, first observed on the third Monday of February 2007.">
      <DayOfWeekInMonth month="February" dayOfWeek="Monday" weekOrdinal="Third" />
      <Tag>ProvinceHoliday</Tag>
    </Rule>
    <Rule name="weekday-3rd-mon-feb-ca-on"
          category="Holiday"
          territory="CA-ON"
          nonWorking="true"
          firstYear="2008"
          comment="Introduced in Ontario by the Family Day Act, first observed on the third Monday of February 2008.">
      <DayOfWeekInMonth month="February" dayOfWeek="Monday" weekOrdinal="Third" />
      <Tag>ProvinceHoliday</Tag>
    </Rule>
    <Rule name="weekday-3rd-mon-feb-ca-bc"
          category="Holiday"
          territory="CA-BC"
          nonWorking="true"
          firstYear="2013"
          comment="Introduced in British Columbia, first observed on the third Monday of February 2013.">
      <DayOfWeekInMonth month="February" dayOfWeek="Monday" weekOrdinal="Third" />
      <Tag>ProvinceHoliday</Tag>
    </Rule>
    <Rule name="weekday-3rd-mon-feb-ca-nb"
          category="Holiday"
          territory="CA-NB"
          nonWorking="true"
          firstYear="2018"
          comment="Introduced in New Brunswick, first observed on the third Monday of February 2018.">
      <DayOfWeekInMonth month="February" dayOfWeek="Monday" weekOrdinal="Third" />
      <Tag>ProvinceHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Island Day">
    <Rule name="weekday-3rd-mon-feb-ca-pe"
          category="Holiday"
          territory="CA-PE"
          nonWorking="true"
          firstYear="2009"
          comment="Introduced in Prince Edward Island, first observed on the third Monday of February 2009.">
      <DayOfWeekInMonth month="February" dayOfWeek="Monday" weekOrdinal="Third" />
      <Tag>ProvinceHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Louis Riel Day">
    <Rule name="weekday-3rd-mon-feb-ca-mb"
          category="Holiday"
          territory="CA-MB"
          nonWorking="true"
          firstYear="2008"
          comment="Introduced in Manitoba, first observed on the third Monday of February 2008. Named in honor of Louis Riel, Métis leader and founder of the province of Manitoba.">
      <DayOfWeekInMonth month="February" dayOfWeek="Monday" weekOrdinal="Third" />
      <Tag>ProvinceHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Nova Scotia Heritage Day">
    <Rule name="weekday-3rd-mon-feb-ca-ns"
          category="Holiday"
          territory="CA-NS"
          nonWorking="true"
          firstYear="2015"
          comment="Introduced in Nova Scotia, first observed on the third Monday of February 2015, to celebrate Nova Scotia's heritage and culture.">
      <DayOfWeekInMonth month="February" dayOfWeek="Monday" weekOrdinal="Third" />
      <Tag>ProvinceHoliday</Tag>
    </Rule>
  </NotableDate>

  <!--
    Quebec provincial holidays and observances.
  -->

  <NotableDate name="Fête nationale du Québec">
    <Rule name="fixed-jun-24-weekend-roll-ca-qc"
          category="Holiday"
          territory="CA-QC"
          nonWorking="true"
          comment="Saint-Jean-Baptiste Day. Celebrated annually on 24 June; if 24 June falls on a Sunday, the public holiday is observed on 25 June.">
      <Fixed month="June" day="24" />
      <Tag>ProvinceHoliday</Tag>
      <Adjustment key="weekend-roll" when="IfWeekend" action="MoveToNextWeekday" />
    </Rule>
  </NotableDate>

  <!--
    Provincial civic holidays (First Monday August).

    Several provinces observe a general civic holiday on the first Monday of August
    under different names.
  -->

  <NotableDate name="Nunavut Day">
    <Rule name="fixed-jul-09-weekend-roll-ca-nu"
          category="Holiday"
          territory="CA-NU"
          nonWorking="true"
          firstYear="1999"
          comment="Commemorates the passage of the Nunavut Act and the Nunavut Land Claims Agreement Act on 9 July 1993, which led to the establishment of Nunavut on 1 April 1999.">
      <Fixed month="July" day="9" />
      <Tag>TerritoryHoliday</Tag>
      <Adjustment key="weekend-roll" when="IfWeekend" action="MoveToNextWeekday" />
    </Rule>
  </NotableDate>

  <NotableDate name="British Columbia Day">
    <Rule name="weekday-1st-mon-aug-ca-bc"
          category="Holiday"
          territory="CA-BC"
          nonWorking="true">
      <DayOfWeekInMonth month="August" dayOfWeek="Monday" weekOrdinal="First" />
      <Tag>ProvinceHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Civic Holiday">
    <Rule name="weekday-1st-mon-aug-ca-on"
          category="Holiday"
          territory="CA-ON,CA-MB,CA-SK,CA-NU"
          nonWorking="true"
          comment="Observed on the first Monday of August in Ontario (where it is also informally known as Simcoe Day in Toronto), Manitoba, Saskatchewan, and Nunavut. The name and statutory status vary by municipality and territory.">
      <DayOfWeekInMonth month="August" dayOfWeek="Monday" weekOrdinal="First" />
      <Tag>ProvinceHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Heritage Day">
    <Rule name="weekday-1st-mon-aug-ca-ab"
          category="Observance"
          territory="CA-AB"
          comment="Observed on the first Monday of August in Alberta as a general provincial holiday; not a statutory holiday under provincial legislation.">
      <DayOfWeekInMonth month="August" dayOfWeek="Monday" weekOrdinal="First" />
      <Tag>ProvinceHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="New Brunswick Day">
    <Rule name="weekday-1st-mon-aug-ca-nb"
          category="Holiday"
          territory="CA-NB"
          nonWorking="true">
      <DayOfWeekInMonth month="August" dayOfWeek="Monday" weekOrdinal="First" />
      <Tag>ProvinceHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Discovery Day">
    <Rule name="weekday-3rd-mon-aug-ca-yt"
          category="Holiday"
          territory="CA-YT"
          nonWorking="true"
          comment="Celebrated on the third Monday of August in Yukon to commemorate the discovery of gold on Bonanza Creek on 17 August 1896, which triggered the Klondike Gold Rush.">
      <DayOfWeekInMonth month="August" dayOfWeek="Monday" weekOrdinal="Third" />
      <Tag>TerritoryHoliday</Tag>
    </Rule>
  </NotableDate>

</NotableDates>
