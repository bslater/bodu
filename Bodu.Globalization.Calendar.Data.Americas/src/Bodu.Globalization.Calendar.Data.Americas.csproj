<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\bld\Bodu.props" />

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bodu</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <OutputType>Library</OutputType>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Title>Bodu Calendar Data — Americas</Title>
    <Description>Notable-date rule pack for Bodu.Globalization.Calendar covering the Americas: United States and Canada. Embedded XML rule sets layered over the main library via a static AmericasCalendarData factory.</Description>
    <PackageTags>$(PackageTags);calendar;holidays;notable-dates;data-pack;americas;us;ca</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\region-ca.xml" />
    <None Remove="Resources\region-us.xml" />
  </ItemGroup>

  <!--
    Region XMLs are embedded under the historical
    `Bodu.Globalization.Calendar.Resources.*` manifest path so that relative
    `<UseFrom resource="./global-all.xml">` directives continue to resolve against
    the main library's globals via the provider's assembly chain, and so that
    rules referencing each other across the pack/main boundary do not require
    XML edits.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\region-ca.xml">
      <LogicalName>Bodu.Globalization.Calendar.Resources.region-ca.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\region-us.xml">
      <LogicalName>Bodu.Globalization.Calendar.Resources.region-us.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bodu.Globalization.Calendar\src\Bodu.Globalization.Calendar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Bodu.Globalization.Calendar.Data.Americas.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
