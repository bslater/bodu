<?xml version="1.0" encoding="utf-8"?>
<!--
  Poland (PL) notable-date resource using the Western / Gregorian calendar.

  National public holidays (dni wolne od pracy).

  Common European observances are inherited from europe-common.xml and
  localized with territory="PL"; Poland-specific holidays are declared below.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <UseFrom resource="./europe-common.xml">
    <Use name="New Year's Day" territory="PL" />
    <Use name="Epiphany" territory="PL" />
    <Use name="Easter Sunday" territory="PL" />
    <Use name="Easter Monday" territory="PL" />
    <Use name="International Workers' Day" as="Labour Day" territory="PL" />
    <Use name="Pentecost Sunday" as="Whit Sunday" territory="PL" />
    <Use name="Corpus Christi" territory="PL" />
    <Use name="Assumption of Mary" territory="PL" />
    <Use name="All Saints' Day" territory="PL" />
    <Use name="Christmas Day" territory="PL" />
    <Use name="Boxing Day" as="Second Day of Christmas" territory="PL" />
  </UseFrom>

  <!--
    National Polish holidays.
  -->

  <NotableDate name="Constitution Day">
    <Rule name="fixed-may-03-pl" category="Holiday" territory="PL" nonWorking="true" firstYear="1791"
          comment="Święto Konstytucji 3 Maja. Commemorates the Constitution of 3 May 1791, the first codified national constitution in Europe.">
      <Fixed month="May" day="3" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Independence Day">
    <Rule name="fixed-nov-11-pl" category="Holiday" territory="PL" nonWorking="true" firstYear="1918"
          comment="Narodowe Święto Niepodległości. Marks Poland's regaining of independence in 1918 after 123 years of partition.">
      <Fixed month="November" day="11" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

</NotableDates>
