<?xml version="1.0" encoding="utf-8"?>
<!--
  Cyprus (CY) notable-date resource.

  Public holidays of the Republic of Cyprus. The movable Easter cycle follows
  the Eastern Orthodox calendar (cherry-picked from the main library's
  christian-orthodox.xml, anchored on Orthodox Easter Sunday); the fixed
  Gregorian observances come from europe-common.xml.

  Algorithm note: resolving the Orthodox movable feasts requires the
  "orthodox-easter-sunday" INotableDateAlgorithm to be registered with the
  service.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <UseFrom resource="./europe-common.xml">
    <Use name="New Year's Day" territory="CY" />
    <Use name="Epiphany" territory="CY" />
    <Use name="International Workers' Day" as="Labour Day" territory="CY" />
    <Use name="Assumption of Mary" as="Dormition of the Mother of God" territory="CY" />
    <Use name="Christmas Day" territory="CY" />
    <Use name="Boxing Day" as="Second Day of Christmas" territory="CY" />
  </UseFrom>

  <UseFrom resource="./christian-orthodox.xml">
    <Use name="Orthodox Clean Monday" as="Green Monday" category="Holiday" nonWorking="true" territory="CY" />
    <Use name="Orthodox Good Friday" nonWorking="true" territory="CY" />
    <Use name="Orthodox Holy Saturday" category="Holiday" nonWorking="true" territory="CY" />
    <Use name="Orthodox Easter Sunday" territory="CY" />
    <Use name="Orthodox Easter Monday" nonWorking="true" territory="CY" />
    <Use name="Orthodox Pentecost Monday" as="Holy Spirit Monday" category="Holiday" nonWorking="true" territory="CY" />
  </UseFrom>

  <!--
    National Cypriot holidays.
  -->

  <NotableDate name="Greek Independence Day">
    <Rule name="fixed-mar-25-cy" category="Holiday" territory="CY" nonWorking="true" firstYear="1821"
          comment="Commemorates the start of the Greek War of Independence on 25 March 1821, observed throughout the Greek Cypriot community.">
      <Fixed month="March" day="25" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Cyprus National Day">
    <Rule name="fixed-apr-01-cy" category="Holiday" territory="CY" nonWorking="true" firstYear="1955"
          comment="EOKA Day. Marks the start of the 1955 liberation struggle against British colonial rule.">
      <Fixed month="April" day="1" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Cyprus Independence Day">
    <Rule name="fixed-oct-01-cy" category="Holiday" territory="CY" nonWorking="true" firstYear="1960"
          comment="Marks the independence of the Republic of Cyprus from the United Kingdom on 1 October 1960.">
      <Fixed month="October" day="1" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Ochi Day">
    <Rule name="fixed-oct-28-cy" category="Holiday" territory="CY" nonWorking="true" firstYear="1940"
          comment="Commemorates the Greek rejection of the Italian ultimatum of 28 October 1940, observed jointly with Greece.">
      <Fixed month="October" day="28" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

</NotableDates>
