<?xml version="1.0" encoding="utf-8"?>
<!--
  Finland (FI) notable-date resource using the Western / Gregorian calendar.

  National public holidays (juhlapyhät). Midsummer Day and All Saints' Day
  fall on a Saturday in a fixed week each year (movable) and cannot be
  expressed with the available fixed/weekday strategies, so they are omitted
  here.

  Common European observances are inherited from europe-common.xml and
  localized with territory="FI"; Finland-specific holidays are declared below.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <UseFrom resource="./europe-common.xml">
    <Use name="New Year's Day" territory="FI" />
    <Use name="Epiphany" territory="FI" />
    <Use name="Easter Sunday" territory="FI" />
    <Use name="Good Friday" territory="FI" />
    <Use name="Easter Monday" territory="FI" />
    <Use name="International Workers' Day" as="May Day" territory="FI" />
    <Use name="Ascension Day" territory="FI" />
    <Use name="Pentecost Sunday" as="Whit Sunday" territory="FI" />
    <Use name="Christmas Eve" nonWorking="true" category="Holiday" territory="FI" />
    <Use name="Christmas Day" territory="FI" />
    <Use name="Boxing Day" as="Saint Stephen's Day" territory="FI" />
  </UseFrom>

  <!--
    National Finnish holidays.
  -->

  <NotableDate name="Independence Day">
    <Rule name="fixed-dec-06-fi" category="Holiday" territory="FI" nonWorking="true" firstYear="1917"
          comment="Itsenäisyyspäivä. Marks Finland's declaration of independence from Russia on 6 December 1917.">
      <Fixed month="December" day="6" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

</NotableDates>
