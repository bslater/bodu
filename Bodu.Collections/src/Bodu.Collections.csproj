<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build configuration and NuGet package metadata. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <RootNamespace>Bodu</RootNamespace>
    <IsAotCompatible Condition="'$(BoduTfmIsNetCore)' == 'true'">true</IsAotCompatible>
    <Title>Bodu — Collections</Title>
    <Description>Specialized generic collections for .NET 8: circular buffer, deque, evicting dictionary, sequenced dictionary, indexed and ordered sets, indexed priority queue, multi-value dictionary, multiset, range set and range dictionary, segmented buffer, graphs (adjacency-list graph, traversal and shortest-path algorithms, disjoint set), and trees (n-ary tree, tries). Also ships the approximate sketches in Bodu.Collections.Probabilistic and the RFC 6962 Merkle tree in Bodu.Collections.Merkle — the Merkle Tree Hash with inclusion proofs, consistency proofs and length-bound roots over any HashAlgorithm the caller supplies. Every collection ships a struct enumerator for allocation-free iteration and implements the standard BCL collection interfaces. Thread-safe variants live in Bodu.Collections.Concurrent.</Description>
    <PackageTags>$(PackageTags);collections;circular-buffer;deque;evicting-dictionary;priority-queue;graph;trie;merkle-tree;merkle-proof;rfc6962;inclusion-proof;consistency-proof</PackageTags>
  </PropertyGroup>

  <!--
    InternalsVisibleTo grants:
      - Bodu.Collections.Test       : test project (OrderedSetStorage, EvictingDictionary internal coverage,
                                      TrieCore, etc.).
      - Bodu.Collections.Concurrent : shares the internal eviction-policy engine (EvictionPolicyCore /
                                      EvictionEntry in Collections.Generic.Internal) consumed by
                                      ConcurrentEvictingDictionary's segments.
      - Bodu.Collections.Test       : also covers the shared Merkle source (MerkleTreeFormat prefix values,
                                      MerkleTreeCore primitives), which is internal by design.
    Drop an entry only after a fresh `dotnet build` of the corresponding sibling confirms no internal use.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Bodu.Collections.Test</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Bodu.Collections.Concurrent</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bodu.Core\src\Bodu.Core.csproj" />
  </ItemGroup>

  <!-- RFC 6962 domain-separation prefixes and the stateless tree primitives, shared in source with
       Bodu.Security.Cryptography's level-by-level Merkle types so the prefix values cannot drift apart.
       No symbol is defined here, so the shared files compile into this package's Bodu.Collections.Merkle
       namespace; Bodu.Security.Cryptography compiles the same files under SECURITY_CRYPTOGRAPHY. -->
  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" Link="shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Strongly-typed exception and diagnostic strings (ResX + generated accessor). -->
  <ItemGroup>
    <EmbeddedResource Update="CollectionsResourceStrings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>CollectionsResourceStrings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="CollectionsResourceStrings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CollectionsResourceStrings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
