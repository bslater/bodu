<Project>

  <!--
    Shared, lock-step package-version baseline. Every Bodu library ships at BoduBaseVersion by
    default, so consumers can treat a matched version number across all Bodu.* packages as a
    coherent set.

    Breaking rank: a single library that needs an out-of-band fix overrides this deliberately by
    setting <BoduPackageVersionOverride> in its own .csproj. That property is applied (and reported)
    in the repository-root Directory.Build.targets, which is processed after the project body so the
    divergence is explicit, visible in build output, and auditable in source control. Do not edit
    <VersionPrefix> directly in a project to break rank — use BoduPackageVersionOverride so the
    intent is obvious.
  -->
  <PropertyGroup>
    <BoduBaseVersion>1.0.0</BoduBaseVersion>
    <VersionPrefix>$(BoduBaseVersion)</VersionPrefix>

    <!--
      The second version stream. Since the 1.0.0 cut the solution ships two lock-step streams, split
      along the API-stability tier each package's README declares:

        Stable                  ships at BoduBaseVersion    (the default; no per-project setting)
        Preview / Experimental  ships at BoduPreviewVersion (via BoduPackageVersionOverride below)

      The split exists so the 1.0 compatibility promise is made only by packages that can keep it.
      A preview package stays below 1.0 until its API settles, at which point promoting it is two
      edits: retier its README banner and delete its override.

      A preview package references this property rather than pinning a literal, so moving the
      preview stream stays a one-line edit here. bld/check-release-manifest.sh enforces both that and
      the tier-to-stream agreement, because nothing else reconciles a package's declared tier with
      the version it actually publishes at — and a wrong version cannot be taken back off nuget.org.
    -->
    <BoduPreviewVersion>0.7.1</BoduPreviewVersion>

    <!--
      Package-validation baseline. Set this to the last version every package shipped at, so
      subsequent packs run the ApiCompat comparison against the published packages. One value
      serves both streams: it is the last release in which Stable and preview packages shared a
      version, and every published package therefore has a 0.7.0 predecessor to compare against.
      Empty = validation stays inert (no published baseline exists yet). The baseline is applied
      only to packages listed in bld/release-manifest.txt — packages that have never shipped have
      nothing to compare against — and only to a build with BoduSignAssembly=true (the default),
      because the published packages are strong-named and a comparison against them needs the same
      assembly identity. Applied in the repository-root Directory.Build.targets; see bld/RELEASING.md for the
      release procedure.
    -->
    <BoduPackageValidationBaseline>0.7.0</BoduPackageValidationBaseline>
  </PropertyGroup>

</Project>
