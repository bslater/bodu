<Project>

  <!--
    Centralized target-framework selection. Every .NET project in the tree sets
    <TargetFrameworks>$(BoduNetTargets)</TargetFrameworks> rather than naming a framework
    literally, so the supported matrix is widened or narrowed in exactly one place. Libraries that
    additionally reach down to netstandard2.0 use $(BoduMultiTargetFrameworks).

    BoduNetTargets carries net8.0 alongside net10.0 deliberately: adding a target framework is an
    additive change that existing consumers do not notice, whereas removing net8.0 would strand
    every consumer still on the .NET 8 LTS runtime. Drop net8.0 from this list only as a
    deliberate major-version decision.
  -->
  <PropertyGroup>
    <BoduNetTarget>net8.0</BoduNetTarget>
    <BoduLatestNetTarget>net10.0</BoduLatestNetTarget>
    <BoduNetTargets>net8.0;net10.0</BoduNetTargets>
    <BoduDownlevelTarget>netstandard2.0</BoduDownlevelTarget>
    <BoduMultiTargetFrameworks>net8.0;net10.0;netstandard2.0</BoduMultiTargetFrameworks>
  </PropertyGroup>

  <!--
    True only for .NET (Core) target frameworks. Evaluated per inner build (TargetFramework is a global
    property by then), so it gates net-only switches such as IsAotCompatible to the net8.0 and net10.0
    legs of a multi-targeted project and is empty for the netstandard2.0 leg and the outer build.
  -->
  <PropertyGroup>
    <BoduTfmIsNetCore Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETCoreApp'">true</BoduTfmIsNetCore>
  </PropertyGroup>

</Project>
