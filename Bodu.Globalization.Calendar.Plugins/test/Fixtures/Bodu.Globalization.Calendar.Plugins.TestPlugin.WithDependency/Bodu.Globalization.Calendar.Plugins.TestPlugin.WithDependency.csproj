<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bodu.Globalization.Calendar.Plugins.TestPlugin.WithDependency</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- A loader fixture, not a test assembly: it is listed in bodu.slnx so Visual Studio builds it,
         and IsTestProject=false keeps a solution-wide `dotnet test` from probing it for tests. -->
    <IsTestProject>false</IsTestProject>
    <BoduEnablePackageValidation>false</BoduEnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Bodu.Globalization.Calendar.Plugins.csproj" />
    <ProjectReference Include="..\Bodu.Globalization.Calendar.Plugins.TestPlugin.Dependency\Bodu.Globalization.Calendar.Plugins.TestPlugin.Dependency.csproj" />
  </ItemGroup>

</Project>
