<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(BoduNetTargets)</TargetFrameworks>
    <RootNamespace>Bodu</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bodu.Test\test\Bodu.Test.csproj" />
    <ProjectReference Include="..\src\Bodu.Text.Delimited.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures\ReleaseNotes\*-fixes.csv" />
  </ItemGroup>

  <!-- The tests of the line formats' shared source, one copy compiled into each line format's test project, as the
       source is into each serializer. -->
  <ItemGroup>
    <Compile Include="..\..\Bodu.Text.Serialization\flat\test\*.cs" Link="Text.Serialization\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
