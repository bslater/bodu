<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Use all available logical processors -->
    <MaxCpuCount>0</MaxCpuCount>

    <!-- Optional: Disable app domain creation to improve test performance -->
    <DisableAppDomain>true</DisableAppDomain>

    <!-- Kill the test session if it runs longer than 10 minutes per assembly -->
    <TestSessionTimeout>600000</TestSessionTimeout>

    <!--
      Full regression: runs the Smoke, BVT, and Regression tiers — every test except the Stress tier. Stress
      loops (e.g. the RFC 7748 §5.2 one-million-iteration ladder) run for tens of minutes and exceed the
      10-minute session guard above, so they are excluded here and run on demand via stress.runsettings.
      The Census artifact generator is likewise on-demand only and excluded here.
      This is the comprehensive run executed before a release or on-demand.
      Pass this file via the dotnet test settings switch, e.g. /p:RunSettingsFilePath=regression.runsettings.
    -->
    <TestCaseFilter>TestCategory!=Stress&amp;TestCategory!=Census</TestCaseFilter>
  </RunConfiguration>
</RunSettings>
