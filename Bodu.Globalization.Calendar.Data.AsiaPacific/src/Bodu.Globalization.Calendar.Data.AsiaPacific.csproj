<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\bld\Bodu.props" />

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bodu</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <OutputType>Library</OutputType>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\region-au.xml" />
    <None Remove="Resources\region-cn.xml" />
    <None Remove="Resources\region-in.xml" />
    <None Remove="Resources\region-jp.xml" />
    <None Remove="Resources\region-kr.xml" />
    <None Remove="Resources\region-my.xml" />
    <None Remove="Resources\region-nz.xml" />
    <None Remove="Resources\region-sg.xml" />
  </ItemGroup>

  <!--
    Region XMLs are embedded under the historical
    `Bodu.Globalization.Calendar.Resources.*` manifest path so that relative
    `<UseFrom resource="./global-all.xml">` directives continue to resolve against
    the main library's globals via the provider's assembly chain, and so that
    rules referencing each other across the pack/main boundary do not require
    XML edits.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\region-au.xml">
      <LogicalName>Bodu.Globalization.Calendar.Resources.region-au.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\region-cn.xml">
      <LogicalName>Bodu.Globalization.Calendar.Resources.region-cn.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\region-in.xml">
      <LogicalName>Bodu.Globalization.Calendar.Resources.region-in.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\region-jp.xml">
      <LogicalName>Bodu.Globalization.Calendar.Resources.region-jp.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\region-kr.xml">
      <LogicalName>Bodu.Globalization.Calendar.Resources.region-kr.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\region-my.xml">
      <LogicalName>Bodu.Globalization.Calendar.Resources.region-my.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\region-nz.xml">
      <LogicalName>Bodu.Globalization.Calendar.Resources.region-nz.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\region-sg.xml">
      <LogicalName>Bodu.Globalization.Calendar.Resources.region-sg.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bodu.Globalization.Calendar\src\Bodu.Globalization.Calendar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Bodu.Globalization.Calendar.Data.AsiaPacific.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
