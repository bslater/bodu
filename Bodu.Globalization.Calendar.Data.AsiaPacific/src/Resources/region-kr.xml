<?xml version="1.0" encoding="utf-8"?>
<!-- South Korea notable-date resource. -->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <UseFrom resource="./global-lunar.xml">
    <Use name="Lunar New Year" as="Seollal" territory="KR" nonWorking="true" durationDays="3" comment="South Korean public-holiday period. The durationDays value of 3 represents the day before Seollal, Seollal day, and the day after when resolved by the regional rule." />
    <Use name="Mid-Autumn Festival" as="Chuseok" territory="KR" nonWorking="true" durationDays="3" comment="South Korean public-holiday period. The durationDays value of 3 represents the day before Chuseok, Chuseok day, and the day after. Chuseok falls on the fifteenth day of the eighth lunar month, the same date as the Chinese Mid-Autumn Festival, here resolved via the ChineseLunisolarCalendar Fixed rule." />
  </UseFrom>

  <UseFrom resource="./global-buddhist.xml">
    <Use name="Vesak" as="Buddha's Birthday" territory="KR" nonWorking="true" />
  </UseFrom>

