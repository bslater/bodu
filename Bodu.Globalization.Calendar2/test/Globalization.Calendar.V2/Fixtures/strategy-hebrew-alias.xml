<?xml version="1.0" encoding="utf-8"?>
<!--
  Hebrew month-alias fixtures for the v2 engine tests (ported from the v1
  NotableDateRuleResolverTests.HebrewAlias tests). Each concept is a global Hebrew fixed-date rule on day 1
  using one supported month token, resolved by a calendar-year sweep across Gregorian 2026 (Hebrew 5786
  regular and 5787 leap) so every alias arm is exercised. The simple months (Tishri..AdarI) are numeric
  indices; the leap-shifting months (LastAdar..Elul) are aliases whose index depends on whether the Hebrew
  year has thirteen months.
-->
<NotableDateResource xmlns="urn:bodu:globalization:calendar" schemaVersion="1.0" resourceId="test.strategy.hebrew-alias">

  <ResolutionPolicy duplicatePolicy="Error" priorityDirection="HigherWins" />

  <NotableDates>

    <NotableDate id="alias-tishri" displayName="Tishri" category="Religious" defaultNonWorkingDay="false">
      <Rules><Rule id="r"><Applicability calendar="Hebrew" /><Strategy><Fixed month="Tishri" day="1" sweepCalendarYears="true" /></Strategy></Rule></Rules>
    </NotableDate>

