<?xml version="1.0" encoding="utf-8"?>
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
  vc:minVersion="1.1"
  elementFormDefault="qualified"
  attributeFormDefault="unqualified"
  targetNamespace="urn:bodu:globalization:calendar"
  xmlns:nd="urn:bodu:globalization:calendar">

  <!-- ============================================================
       Root: zero or more UseFrom directives that cherry-pick rules
       from other resources, followed by zero or more locally
       declared NotableDate entries.
       ============================================================ -->
  <xs:element name="NotableDates">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="UseFrom" type="nd:UseFrom" minOccurs="0" maxOccurs="unbounded" />
        <xs:element name="NotableDate" type="nd:NotableDate" minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============================================================
       UseFrom: cherry-picks one or more notable date rules from
       another manifest resource. Each child Use element selects a
       single named rule and may override scalar properties on the
       inherited rule; UseAll is a deliberate opt-in for "every
       rule in this resource". A document never inherits a rule it
       has not explicitly listed, so adding a new rule to a source
       file never cascades into its consumers.
       ============================================================ -->
  <xs:complexType name="UseFrom">
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="UseAll">
        <xs:complexType />
      </xs:element>
      <xs:element name="Use" type="nd:Use" />
    </xs:choice>
    <xs:attribute name="resource" type="xs:string" use="required" />
  </xs:complexType>

  <!-- ============================================================
       Use: cherry-picks one or more notable date rules by canonical
       name from the enclosing UseFrom's source resource. Every rule
       in the source whose <NotableDate name> matches is brought
       across; with multiple matches the directive's flat scalars
       (territory, nonWorking, etc.) broadcast to every variant.
       A nested Rule child provides an extensible override body: it
       may override any scalar, replace the strategy element, add
       Tag children (union-merged with inherited tags), or add
       Adjustment children (merged by key). When the body declares
       a name attribute, the override applies only to the inherited
       rule whose <Rule name> matches; other variants pass through
       with the directive's flat scalars but none of the body's
       per-rule changes. The optional clearTags and clearAdjustments
       flags discard the inherited set before the override is
       applied; clearInherited drops every inherited variant for
       this directive entirely, leaving only the rule materialized
       from the directive itself. When both a flat attribute on Use
       and the nested Rule specify the same scalar, the nested Rule
       wins (innermost-wins). The optional 'as' attribute renames
       the rule locally.
       ============================================================ -->
  <xs:complexType name="Use">
    <xs:sequence>
      <xs:element name="Rule" type="nd:OverrideRule" minOccurs="0" maxOccurs="1" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attribute name="as" type="xs:string" use="optional" />
    <xs:attribute name="clearTags" type="xs:boolean" use="optional" default="false" />
    <xs:attribute name="clearAdjustments" type="xs:boolean" use="optional" default="false" />
    <xs:attribute name="clearInherited" type="xs:boolean" use="optional" default="false" />
    <!-- clear: whitespace/comma-separated list of inherited nullable fields to reset to null
         (territory, calendarType, firstYear, lastYear, occurrenceYears, nonWorking, comment). -->
    <xs:attribute name="clear" type="xs:string" use="optional" />
    <xs:attribute name="category" type="nd:notableDateCategory" use="optional" />
    <xs:attribute name="territory" type="nd:territory" use="optional" />
    <xs:attribute name="nonWorking" type="xs:boolean" use="optional" />
    <xs:attribute name="firstYear" type="xs:unsignedShort" use="optional" />
    <xs:attribute name="lastYear" type="xs:unsignedShort" use="optional" />
    <xs:attribute name="occurrenceYears" type="xs:positiveInteger" use="optional" />
    <xs:attribute name="durationDays" type="nd:durationDays" use="optional" />
    <xs:attribute name="priority" type="xs:int" use="optional" />
    <xs:attribute name="comment" type="xs:string" use="optional" />
  </xs:complexType>

  <!-- ============================================================
       NotableDate: one notable date with one or more authoring rules.
       ============================================================ -->
  <xs:complexType name="NotableDate">
    <xs:sequence>
      <xs:element name="Rule" type="nd:Rule" minOccurs="1" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
  </xs:complexType>

  <!-- ============================================================
       Rule: a single resolution rule. Exactly one strategy element
       (Fixed | DayOfWeekInMonth | OffsetFromAnchor | Algorithm)
       followed by zero or more Tag and Adjustment elements. The
       'name' attribute carries a rule-level identifier (RuleName)
       distinct from the parent <NotableDate>'s canonical title; it
       is what consumers target via a Use directive's nested Rule
       body when a notable date is described by more than one rule
       (era splits, regional variants, alternate calendars).
       ============================================================ -->
  <xs:complexType name="Rule">
    <xs:sequence>
      <xs:choice minOccurs="1" maxOccurs="1">
        <xs:element name="Fixed">
          <!-- When calendarType is set on the enclosing Rule, month and day are
               interpreted in that calendar system (e.g. ChineseLunisolarCalendar,
               HijriCalendar, HebrewCalendar) and the resolver converts the result
               to a Gregorian DateTime. Without calendarType, month and day are
               Gregorian (1–12).
               skipLeapMonth: for ChineseLunisolarCalendar rules — advances the
               calendar month past any intercalary leap month that precedes it.
               sweepCalendarYears: for calendars whose year does not align with
               the Gregorian year (HijriCalendar, HebrewCalendar) — tries both
               calendar years that overlap the requested Gregorian year. -->
          <xs:complexType>
            <xs:attribute name="day" type="nd:day" use="required" />
            <xs:attribute name="month" type="nd:monthOrNumber" use="required" />
            <xs:attribute name="skipLeapMonth" type="xs:boolean" use="optional" />
            <xs:attribute name="sweepCalendarYears" type="xs:boolean" use="optional" />
          </xs:complexType>
        </xs:element>
        <xs:element name="DayOfWeekInMonth">
          <xs:complexType>
            <xs:attribute name="month" type="nd:monthName" use="required" />
            <xs:attribute name="dayOfWeek" type="nd:dayOfWeek" use="required" />
            <xs:attribute name="weekOrdinal" type="nd:weekOrdinal" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="OffsetFromAnchor">
          <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required" />
            <xs:attribute name="offset" type="xs:int" use="required" />
          </xs:complexType>
        </xs:element>
        <!-- The target weekday positioned relative to a fixed reference month/day:
             direction="OnOrAfter" selects the first such weekday on or after the
             reference (e.g. Nordic Midsummer, the Saturday on or after 20 June);
             direction="OnOrBefore" selects the first such weekday on or before it
             (e.g. German Repentance Day, the Wednesday before 23 November = the
             Wednesday on or before 22 November); direction="Nearest" selects the
             closest occurrence in either direction (e.g. the Monday nearest a date). -->
        <xs:element name="WeekdayNearDate">
          <xs:complexType>
            <xs:attribute name="dayOfWeek" type="nd:dayOfWeek" use="required" />
            <xs:attribute name="month" type="nd:monthName" use="required" />
            <xs:attribute name="day" type="nd:day" use="required" />
            <xs:attribute name="direction" type="nd:weekdayProximity" use="required" />
          </xs:complexType>
        </xs:element>
        <!-- A target weekday (relativeDayOfWeek) positioned, via direction, relative to
             an anchor that is the weekOrdinal-th dayOfWeek of the month — for example
             "the Tuesday on or after the first Monday in November" (US Election Day). -->
        <xs:element name="RelativeWeekdayInMonth">
          <xs:complexType>
            <xs:attribute name="dayOfWeek" type="nd:dayOfWeek" use="required" />
            <xs:attribute name="month" type="nd:monthName" use="required" />
            <xs:attribute name="weekOrdinal" type="nd:weekOrdinal" use="required" />
            <xs:attribute name="relativeDayOfWeek" type="nd:dayOfWeek" use="required" />
            <xs:attribute name="direction" type="nd:weekdayProximity" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="Algorithm">
          <xs:complexType>
            <xs:attribute name="key" type="xs:string" use="optional" />
            <xs:attribute name="type" type="nd:assemblyTypeName" use="optional" />
            <xs:attribute name="month" type="xs:string" use="optional" />
            <xs:attribute name="day" type="xs:int" use="optional" />
          </xs:complexType>
        </xs:element>
      </xs:choice>

      <xs:element name="Tag" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="Adjustment" type="nd:Adjustment" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>

    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attribute name="category" type="nd:notableDateCategory" use="required" />
    <xs:attribute name="nonWorking" type="xs:boolean" use="optional" />
    <xs:attribute name="firstYear" type="xs:unsignedShort" use="optional" />
    <xs:attribute name="lastYear" type="xs:unsignedShort" use="optional" />
    <xs:attribute name="occurrenceYears" type="xs:positiveInteger" use="optional" />
    <xs:attribute name="durationDays" type="nd:durationDays" use="optional" />
    <xs:attribute name="priority" type="xs:int" use="optional" />
    <xs:attribute name="calendarType" type="nd:assemblyTypeName" use="optional" />
    <xs:attribute name="territory" type="nd:territory" use="optional" />
    <xs:attribute name="comment" type="xs:string" use="optional" />
  </xs:complexType>

  <!-- ============================================================
       OverrideRule: the payload form used inside a <Use> directive.
       Mirrors Rule but relaxes two constraints: the strategy choice
       is optional (a Use may add tags or adjustments without
       replacing the inherited strategy), and no attribute is
       required. Any field present here overrides the inherited
       value; fields left absent fall through from the inherited
       rule. The 'name' attribute is treated as a rule-level
       identifier (RuleName) rather than the canonical notable-date
       title — when set, it targets the inherited rule whose
       <Rule name> matches and is propagated onto the merged result;
       authors who need to rename the inherited rule should use the
       directive's 'as' attribute instead. Tag children merge
       additively with inherited tags; Adjustment children merge by
       key (replace-if-matched, append-if-new).
       ============================================================ -->
  <xs:complexType name="OverrideRule">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="1">
        <xs:element name="Fixed">
          <xs:complexType>
            <xs:attribute name="day" type="nd:day" use="required" />
            <xs:attribute name="month" type="nd:monthOrNumber" use="required" />
            <xs:attribute name="skipLeapMonth" type="xs:boolean" use="optional" />
            <xs:attribute name="sweepCalendarYears" type="xs:boolean" use="optional" />
          </xs:complexType>
        </xs:element>
        <xs:element name="DayOfWeekInMonth">
          <xs:complexType>
            <xs:attribute name="month" type="nd:monthName" use="required" />
            <xs:attribute name="dayOfWeek" type="nd:dayOfWeek" use="required" />
            <xs:attribute name="weekOrdinal" type="nd:weekOrdinal" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="OffsetFromAnchor">
          <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required" />
            <xs:attribute name="offset" type="xs:int" use="required" />
          </xs:complexType>
        </xs:element>
        <!-- The target weekday positioned relative to a fixed reference month/day:
             direction="OnOrAfter" selects the first such weekday on or after the
             reference (e.g. Nordic Midsummer, the Saturday on or after 20 June);
             direction="OnOrBefore" selects the first such weekday on or before it
             (e.g. German Repentance Day, the Wednesday before 23 November = the
             Wednesday on or before 22 November); direction="Nearest" selects the
             closest occurrence in either direction (e.g. the Monday nearest a date). -->
        <xs:element name="WeekdayNearDate">
          <xs:complexType>
            <xs:attribute name="dayOfWeek" type="nd:dayOfWeek" use="required" />
            <xs:attribute name="month" type="nd:monthName" use="required" />
            <xs:attribute name="day" type="nd:day" use="required" />
            <xs:attribute name="direction" type="nd:weekdayProximity" use="required" />
          </xs:complexType>
        </xs:element>
        <!-- A target weekday (relativeDayOfWeek) positioned, via direction, relative to
             an anchor that is the weekOrdinal-th dayOfWeek of the month — for example
             "the Tuesday on or after the first Monday in November" (US Election Day). -->
        <xs:element name="RelativeWeekdayInMonth">
          <xs:complexType>
            <xs:attribute name="dayOfWeek" type="nd:dayOfWeek" use="required" />
            <xs:attribute name="month" type="nd:monthName" use="required" />
            <xs:attribute name="weekOrdinal" type="nd:weekOrdinal" use="required" />
            <xs:attribute name="relativeDayOfWeek" type="nd:dayOfWeek" use="required" />
            <xs:attribute name="direction" type="nd:weekdayProximity" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="Algorithm">
          <xs:complexType>
            <xs:attribute name="key" type="xs:string" use="optional" />
            <xs:attribute name="type" type="nd:assemblyTypeName" use="optional" />
            <xs:attribute name="month" type="xs:string" use="optional" />
            <xs:attribute name="day" type="xs:int" use="optional" />
          </xs:complexType>
        </xs:element>
      </xs:choice>

      <xs:element name="Tag" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="Adjustment" type="nd:Adjustment" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>

    <!-- ruleName targets a specific inherited variant; the legacy 'name' attribute is accepted as an alias. Both
         name and category are optional so a Use may apply a partial override (e.g. priority only). -->
    <xs:attribute name="ruleName" type="xs:string" use="optional" />
    <xs:attribute name="name" type="xs:string" use="optional" />
    <xs:attribute name="category" type="nd:notableDateCategory" use="optional" />
    <xs:attribute name="nonWorking" type="xs:boolean" use="optional" />
    <xs:attribute name="firstYear" type="xs:unsignedShort" use="optional" />
    <xs:attribute name="lastYear" type="xs:unsignedShort" use="optional" />
    <xs:attribute name="occurrenceYears" type="xs:positiveInteger" use="optional" />
    <xs:attribute name="durationDays" type="nd:durationDays" use="optional" />
    <xs:attribute name="priority" type="xs:int" use="optional" />
    <xs:attribute name="calendarType" type="nd:assemblyTypeName" use="optional" />
    <xs:attribute name="territory" type="nd:territory" use="optional" />
    <xs:attribute name="comment" type="xs:string" use="optional" />
  </xs:complexType>

  <!-- ============================================================
       Adjustment: a conditional date shift attached to a Rule.
       The required 'key' attribute identifies the adjustment for
       inheritance merging: when a <Use> override declares an
       Adjustment with a key already present on the inherited
       rule, the override replaces it in place; otherwise it is
       appended. Keys are author-defined and should be unique
       within a single rule's adjustment sequence; convention is
       kebab-case (e.g. "weekend-roll", "boxing-day-monday-sub").
       ============================================================ -->
  <xs:complexType name="Adjustment">
    <!-- Optional Param children supply key/value parameters forwarded to a custom IAdjustmentHandler. -->
    <xs:sequence>
      <xs:element name="Param" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="key" type="xs:string" use="required" />
          <xs:attribute name="value" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="key" type="xs:string" use="required" />
    <xs:attribute name="when" type="nd:adjustmentTrigger" use="required" />
    <xs:attribute name="action" type="nd:adjustmentAction" use="required" />
    <xs:attribute name="dayOfWeek" type="nd:dayOfWeek" use="optional" />
    <xs:attribute name="weekOrdinal" type="nd:weekOrdinal" use="optional" />
    <xs:attribute name="days" type="xs:int" use="optional" />
    <xs:attribute name="priority" type="xs:int" use="optional" />
    <xs:attribute name="nonWorking" type="xs:boolean" use="optional" />
    <xs:attribute name="territory" type="nd:territory" use="optional" />
    <xs:attribute name="calendarType" type="nd:assemblyTypeName" use="optional" />
    <xs:attribute name="fromYear" type="xs:unsignedShort" use="optional" />
    <xs:attribute name="toYear" type="xs:unsignedShort" use="optional" />
    <xs:attribute name="comparisonMonth" type="nd:monthName" use="optional" />
    <xs:attribute name="comparisonDay" type="nd:day" use="optional" />
    <xs:attribute name="target" type="xs:string" use="optional" />
    <!-- maxReachDays: symmetric +/- day envelope used by the range planner to size the fringe scan. -->
    <xs:attribute name="maxReachDays" type="xs:int" use="optional" />
    <!-- appliesToGlobalRules: opt a territory/calendar-scoped adjustment into territory/calendar-neutral rules. -->
    <xs:attribute name="appliesToGlobalRules" type="xs:boolean" use="optional" />
    <xs:attribute name="handlerKey" type="xs:string" use="optional" />
  </xs:complexType>

  <!-- ============================================================
       Simple types
       ============================================================ -->
  <xs:simpleType name="adjustmentTrigger">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Always" />
      <xs:enumeration value="IfDayOfWeek" />
      <xs:enumeration value="IfWeekend" />
      <xs:enumeration value="IfWeekday" />
      <xs:enumeration value="IfNonWorkingDay" />
      <xs:enumeration value="IfBeforeFixedDate" />
      <xs:enumeration value="IfAfterFixedDate" />
      <xs:enumeration value="IfLeapYear" />
      <xs:enumeration value="IfNthOccurrenceInMonth" />
      <xs:enumeration value="Custom" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="adjustmentAction">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="AddDays" />
      <xs:enumeration value="MoveToNextWeekday" />
      <xs:enumeration value="MoveToPreviousWeekday" />
      <xs:enumeration value="MoveToNextWorkingDay" />
      <!-- MoveToNextNonWorkingDay: legacy alias for MoveToNextWorkingDay, retained for back-compatibility. -->
      <xs:enumeration value="MoveToNextNonWorkingDay" />
      <xs:enumeration value="ReplaceWithNamedDate" />
      <xs:enumeration value="Custom" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="notableDateCategory">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="Holiday" />
      <xs:enumeration value="Observance" />
      <xs:enumeration value="Remembrance" />
      <xs:enumeration value="Cultural" />
      <xs:enumeration value="Religious" />
      <xs:enumeration value="Seasonal" />
      <xs:enumeration value="Civic" />
      <xs:enumeration value="Bank" />
      <xs:enumeration value="School" />
      <xs:enumeration value="Regional" />
      <xs:enumeration value="Other" />
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="territory">
    <xs:restriction base="xs:string">
      <xs:pattern value="^([A-Z]{2}(-[A-Z0-9]{2,3})?)(,([A-Z]{2}(-[A-Z0-9]{2,3})?))*$" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="assemblyTypeName">
    <xs:restriction base="xs:string">
      <xs:pattern value="^(([A-Za-z][A-Za-z0-9.+]*?){1,}?)(,\s?([^/\\:*?&quot;&lt;&gt;|]*((,\s?(Version=(\d\.?){1,4}|Culture=(neutral|\w{2}-\w{2})|PublicKeyToken=[a-f0-9]{16})(,\s?)?){3}|))){0,1}$" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="day">
    <xs:restriction base="xs:int">
      <xs:minInclusive value="1" />
      <xs:maxInclusive value="31" />
    </xs:restriction>
  </xs:simpleType>

  <!-- durationDays: a multi-day span length, bounded to a single year so EndDate cannot run away. -->
  <xs:simpleType name="durationDays">
    <xs:restriction base="xs:int">
      <xs:minInclusive value="1" />
      <xs:maxInclusive value="366" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="monthName">
    <xs:restriction base="xs:string">
      <xs:enumeration value="January" />
      <xs:enumeration value="February" />
      <xs:enumeration value="March" />
      <xs:enumeration value="April" />
      <xs:enumeration value="May" />
      <xs:enumeration value="June" />
      <xs:enumeration value="July" />
      <xs:enumeration value="August" />
      <xs:enumeration value="September" />
      <xs:enumeration value="October" />
      <xs:enumeration value="November" />
      <xs:enumeration value="December" />
    </xs:restriction>
  </xs:simpleType>

  <!-- monthOrNumber: used by Fixed rules. Accepts a full English month name
       (Gregorian rules), an integer 1–13 (numeric month in the calendarType system),
       or a Hebrew month name (for rules using calendarType with HebrewCalendar).
       Simple Hebrew months with a fixed calendar position (Tishri through AdarII)
       are stored as integers 1–7 by the parser. Months whose position is leap-year
       dependent (LastAdar, Nisan through Elul) are stored as a CalendarMonthAlias
       and resolved at runtime by the resolver. -->
  <xs:simpleType name="monthOrNumber">
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <!-- Gregorian month names -->
          <xs:enumeration value="January" />
          <xs:enumeration value="February" />
          <xs:enumeration value="March" />
          <xs:enumeration value="April" />
          <xs:enumeration value="May" />
          <xs:enumeration value="June" />
          <xs:enumeration value="July" />
          <xs:enumeration value="August" />
          <xs:enumeration value="September" />
          <xs:enumeration value="October" />
          <xs:enumeration value="November" />
          <xs:enumeration value="December" />
          <!-- Hebrew month names (fixed position 1–7: Tishri through AdarII) -->
          <xs:enumeration value="Tishri" />
          <xs:enumeration value="Heshvan" />
          <xs:enumeration value="Kislev" />
          <xs:enumeration value="Tevet" />
          <xs:enumeration value="Shevat" />
          <xs:enumeration value="AdarI" />
          <xs:enumeration value="AdarII" />
          <!-- Hebrew month names (leap-year-dependent position) -->
          <xs:enumeration value="LastAdar" />
          <xs:enumeration value="Nisan" />
          <xs:enumeration value="Iyar" />
          <xs:enumeration value="Sivan" />
          <xs:enumeration value="Tammuz" />
          <xs:enumeration value="Av" />
          <xs:enumeration value="Elul" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType>
        <xs:restriction base="xs:positiveInteger">
          <xs:minInclusive value="1" />
          <xs:maxInclusive value="13" />
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <xs:simpleType name="dayOfWeek">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Monday" />
      <xs:enumeration value="Tuesday" />
      <xs:enumeration value="Wednesday" />
      <xs:enumeration value="Thursday" />
      <xs:enumeration value="Friday" />
      <xs:enumeration value="Saturday" />
      <xs:enumeration value="Sunday" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="weekOrdinal">
    <xs:restriction base="xs:string">
      <xs:enumeration value="First" />
      <xs:enumeration value="Second" />
      <xs:enumeration value="Third" />
      <xs:enumeration value="Fourth" />
      <xs:enumeration value="Fifth" />
      <xs:enumeration value="Last" />
    </xs:restriction>
  </xs:simpleType>

  <!-- weekdayProximity: used by WeekdayNearDate rules to position the target
       weekday relative to the reference month/day. -->
  <xs:simpleType name="weekdayProximity">
    <xs:restriction base="xs:string">
      <xs:enumeration value="OnOrAfter" />
      <xs:enumeration value="OnOrBefore" />
      <xs:enumeration value="Nearest" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
