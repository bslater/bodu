<?xml version="1.0" encoding="utf-8"?>
<!--
  United Kingdom public holidays and widely observed cultural dates.
  Imports the universal Common set and the Christian liturgical set;
  adds only UK-specific entries.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <Import resource="Bodu.Globalization.Calendar.Resources.Common.xml" />
  <Import resource="Bodu.Globalization.Calendar.Resources.Christian.xml" />

  <!-- The UK does not officially observe these as public holidays. -->
  <Suppress name="Whit Monday" />
  <Suppress name="Ascension Day" />
  <Suppress name="Pentecost Sunday" />
  <Suppress name="All Saints' Day" />
  <Suppress name="International Workers' Day" />

  <!-- New Year's Day in the UK rolls forward to the following Monday when it falls on a weekend. -->
  <NotableDate name="New Year's Day">
    <Rule category="Holiday" territory="GB" nonWorking="true">
      <Tag>BankHoliday</Tag>
      <Fixed month="January" day="1" />
      <Adjustment when="IfWeekend" action="MoveToNextWeekday" />
    </Rule>
  </NotableDate>

  <!-- January (Scotland) -->
  <NotableDate name="2 January (Scotland)">
    <Rule name="2 January" category="Holiday" territory="GB-SCT" nonWorking="true">
      <Tag>BankHoliday</Tag>
      <Fixed month="January" day="2" />
      <Adjustment when="IfWeekend" action="MoveToNextWeekday" />
    </Rule>
  </NotableDate>

  <NotableDate name="Burns Night">
    <Rule category="Cultural" territory="GB-SCT">
      <Fixed month="January" day="25" />
    </Rule>
  </NotableDate>

  <!-- MARCH -->
  <NotableDate name="Saint Patrick's Day">
    <Rule category="Holiday" territory="GB-NIR" nonWorking="true">
      <Tag>BankHoliday</Tag>
      <Fixed month="March" day="17" />
      <Adjustment when="IfWeekend" action="MoveToNextWeekday" />
    </Rule>
  </NotableDate>

  <!-- APRIL -->
  <NotableDate name="Saint George's Day">
    <Rule category="Cultural" territory="GB-ENG">
      <Fixed month="April" day="23" />
    </Rule>
  </NotableDate>

  <!-- MAY -->
  <NotableDate name="Early May Bank Holiday">
    <Rule category="Holiday" territory="GB" nonWorking="true">
      <Tag>BankHoliday</Tag>
      <DayOfWeekInMonth month="May" dayOfWeek="Monday" weekOrdinal="First" />
    </Rule>
  </NotableDate>

  <NotableDate name="Spring Bank Holiday">
    <Rule category="Holiday" territory="GB" nonWorking="true">
      <Tag>BankHoliday</Tag>
      <DayOfWeekInMonth month="May" dayOfWeek="Monday" weekOrdinal="Last" />
    </Rule>
  </NotableDate>

  <!-- JULY (Northern Ireland) -->
  <NotableDate name="Battle of the Boyne">
    <Rule category="Holiday" territory="GB-NIR" nonWorking="true">
      <Tag>BankHoliday</Tag>
      <Fixed month="July" day="12" />
      <Adjustment when="IfWeekend" action="MoveToNextWeekday" />
    </Rule>
  </NotableDate>

  <!-- AUGUST -->
  <NotableDate name="Summer Bank Holiday (Scotland)">
    <Rule name="Summer Bank Holiday" category="Holiday" territory="GB-SCT" nonWorking="true">
      <Tag>BankHoliday</Tag>
      <DayOfWeekInMonth month="August" dayOfWeek="Monday" weekOrdinal="First" />
    </Rule>
  </NotableDate>

  <NotableDate name="Summer Bank Holiday">
    <Rule category="Holiday" territory="GB-ENG,GB-WLS,GB-NIR" nonWorking="true">
      <Tag>BankHoliday</Tag>
      <DayOfWeekInMonth month="August" dayOfWeek="Monday" weekOrdinal="Last" />
    </Rule>
  </NotableDate>

  <!-- NOVEMBER -->
  <NotableDate name="Bonfire Night">
    <Rule category="Cultural" territory="GB">
      <Fixed month="November" day="5" />
    </Rule>
  </NotableDate>

  <NotableDate name="Saint Andrew's Day">
    <Rule category="Holiday" territory="GB-SCT" nonWorking="true">
      <Tag>BankHoliday</Tag>
      <Fixed month="November" day="30" />
      <Adjustment when="IfWeekend" action="MoveToNextWeekday" />
    </Rule>
  </NotableDate>

  <!-- DECEMBER -->
  <NotableDate name="Boxing Day">
    <Rule category="Holiday" territory="GB" nonWorking="true">
      <Tag>BankHoliday</Tag>
      <Fixed month="December" day="26" />
      <Adjustment when="IfWeekend" action="MoveToNextWeekday" />
    </Rule>
  </NotableDate>
</NotableDates>
