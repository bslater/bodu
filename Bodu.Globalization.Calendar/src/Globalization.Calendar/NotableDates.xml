<?xml version="1.0" encoding="utf-8"?>
<!--
  Default universal resource. Pulls in every rule from the
  Common and Christian sets via UseAll, producing a calendar
  that is appropriate for consumers calling
  `new NotableDateService()` who do not need country-specific
  observances.

  UseAll is a deliberate opt-in for "every rule from this
  resource" and is the only place in the project where wildcard
  inheritance is used. To restrict the active set to a single
  country, construct an XmlResourceNotableDateRuleProvider that
  points directly at one of the country-specific resources
  (US.xml, GB.xml, FR.xml) — those files cherry-pick rules
  individually so that adding new entries to Common or Christian
  never cascades into them.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <UseFrom resource="Bodu.Globalization.Calendar.Resources.Common.xml">
    <UseAll />
  </UseFrom>

  <UseFrom resource="Bodu.Globalization.Calendar.Resources.Christian.xml">
    <UseAll />
  </UseFrom>

</NotableDates>
