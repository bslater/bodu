    <None Remove="Globalization.Calendar.Resources\global-family-social.xml" />
    <None Remove="Globalization.Calendar.Resources\global-family.xml" />
    <None Remove="Globalization.Calendar.Resources\global-food.xml" />
    <None Remove="Globalization.Calendar.Resources\global-health.xml" />
    <None Remove="Globalization.Calendar.Resources\global-hindu.xml" />
    <None Remove="Globalization.Calendar.Resources\global-islamic-umm-al-qura.xml" />
    <None Remove="Globalization.Calendar.Resources\global-islamic.xml" />
    <None Remove="Globalization.Calendar.Resources\global-jewish.xml" />
    <None Remove="Globalization.Calendar.Resources\global-lunar.xml" />
    <None Remove="Globalization.Calendar.Resources\global-multiday-normalization.xml" />
    <None Remove="Globalization.Calendar.Resources\global-persian.xml" />
    <None Remove="Globalization.Calendar.Resources\global-remembrance.xml" />
    <None Remove="Globalization.Calendar.Resources\global-science.xml" />
    <None Remove="Globalization.Calendar.Resources\global-social.xml" />
    <None Remove="Globalization.Calendar.Resources\global-un.xml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="CalendarResourceStrings.resx">
      <LastGenOutput>CalendarResourceStrings.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <Compile Update="CalendarResourceStrings.Designer.cs">
      <DependentUpon>CalendarResourceStrings.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

</Project>
