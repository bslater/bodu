<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bodu</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <OutputType>Library</OutputType>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Bodu.Globalization.Calendar.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bodu.Core\src\Bodu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Globalization.Calendar.Resources\christian-orthodox.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\christian-western.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\default-minimal.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-all.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-anchors.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-animals.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-buddhist.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-core.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-cultural.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-education.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-environment.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-family-social.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-family.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-food.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-health.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-hindu.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-islamic-umm-al-qura.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-islamic.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-jewish.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-lunar.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-multiday-normalization.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-persian.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-remembrance.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-science.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-social.xml" />
    <EmbeddedResource Include="Globalization.Calendar.Resources\global-un.xml" />
    <EmbeddedResource Include="Globalization.Calendar\NotableDates.xsd">
      <LogicalName>Bodu.Globalization.Calendar.NotableDates.v2.xsd</LogicalName>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="Globalization.Calendar\NotableDates.schema.json">
      <LogicalName>Bodu.Globalization.Calendar.NotableDates.v2.schema.json</LogicalName>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="Globalization.Calendar\Resources\*.xml">
      <LogicalName>Bodu.Globalization.Calendar.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Globalization.Calendar.Resources\christian-orthodox.xml" />
    <None Remove="Globalization.Calendar.Resources\christian-western.xml" />
    <None Remove="Globalization.Calendar.Resources\default-minimal.xml" />
    <None Remove="Globalization.Calendar.Resources\global-all.xml" />
    <None Remove="Globalization.Calendar.Resources\global-anchors.xml" />
