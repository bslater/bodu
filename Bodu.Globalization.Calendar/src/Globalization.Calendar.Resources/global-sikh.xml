<?xml version="1.0" encoding="utf-8"?>
<!--
  Sikh notable-date catalogue
  ================================================================================================================

  A common-library catalogue of high-reuse Sikh notable dates. The schema does not currently expose a Nanakshahi or
  Bikrami calendar system, so this catalogue uses two deterministic patterns supported by the engine: fixed civil
  Gregorian dates for widely used modern Nanakshahi-style observances, and the existing Hindu lunar algorithm where a
  Sikh observance deliberately coincides with a broader Indian lunisolar festival date. Territory and community packs
  can override any locally published gurpurab or committee-calendar date.

  Convention (matching the other common catalogues): each concept carries the bare calculation strategy under the
  stable rule id "default" with no territory scope. A territory pack imports the concept it observes through an
  <Import><Use> directive and supplies its own territory scope, category, non-working flag, and any weekend adjustment
  there. The catalogue default category is Religious; a pack that observes one as a cultural or public holiday overrides
  category/nonWorking on its own <Use>.
-->
<NotableDateResource xmlns="urn:bodu:globalization:calendar" schemaVersion="1.0" resourceId="common.global-sikh">

  <NotableDates>

    <!--
      ============================================================================================================
      Fixed civil / Nanakshahi-style observances
      ============================================================================================================
      These are authored as fixed Gregorian dates because the current schema does not have a Sikh calendar type.
      Community calendars may publish different lunar-traditional dates for some gurpurabs; territory packs can
      override where required.
    -->

    <!-- Guru Gobind Singh Jayanti — 5 January by modern fixed-date convention in some Nanakshahi calendars. Strategy: Fixed day-of-month. -->
    <NotableDate id="guru-gobind-singh-jayanti" displayName="Guru Gobind Singh Jayanti" category="Religious" defaultNonWorkingDay="false">
      <Rules><Rule id="default"><Strategy><Fixed month="January" day="5" /></Strategy></Rule></Rules>
    </NotableDate>

    <!-- Vaisakhi — 14 April; Khalsa foundation and major Sikh festival. Strategy: Fixed day-of-month. -->
    <NotableDate id="vaisakhi" displayName="Vaisakhi" category="Religious" defaultNonWorkingDay="false">
      <Rules><Rule id="default"><Strategy><Fixed month="April" day="14" /></Strategy></Rule></Rules>
    </NotableDate>

    <!-- Martyrdom of Guru Arjan Dev — 16 June by common modern fixed-date convention. Strategy: Fixed day-of-month. -->
    <NotableDate id="martyrdom-of-guru-arjan-dev" displayName="Martyrdom of Guru Arjan Dev" category="Religious" defaultNonWorkingDay="false">
      <Rules><Rule id="default"><Strategy><Fixed month="June" day="16" /></Strategy></Rule></Rules>
    </NotableDate>

    <!-- Martyrdom of Guru Tegh Bahadur — 24 November by common modern fixed-date convention. Strategy: Fixed day-of-month. -->
    <NotableDate id="martyrdom-of-guru-tegh-bahadur" displayName="Martyrdom of Guru Tegh Bahadur" category="Religious" defaultNonWorkingDay="false">
      <Rules><Rule id="default"><Strategy><Fixed month="November" day="24" /></Strategy></Rule></Rules>
    </NotableDate>

    <!--
      ============================================================================================================
      Lunisolar-linked Sikh observances
      ============================================================================================================
      These observances are calculated from existing engine-supported Hindu lunisolar festival keys. The dependency is
      calendrical only: territory packs remain free to override the published Sikh community date.
    -->

    <!-- Hola Mohalla — Sikh martial festival beginning the day after Holi. Strategy: OffsetFromRule from the Holi lunar calculation. -->
    <NotableDate id="hola-mohalla" displayName="Hola Mohalla" category="Religious" defaultNonWorkingDay="false">
      <Rules><Rule id="default" durationDays="3">
        <Strategy><OffsetFromRule notableDateRef="holi-anchor" ruleRef="default" offsetDays="1" /></Strategy></Rule></Rules>
    </NotableDate>

    <!-- Bandi Chhor Divas — Sikh observance that coincides with Diwali. Strategy: Algorithm "diwali". -->
    <NotableDate id="bandi-chhor-divas" displayName="Bandi Chhor Divas" category="Religious" defaultNonWorkingDay="false">
      <Rules><Rule id="default"><Strategy><Algorithm key="diwali" /></Strategy></Rule></Rules>
    </NotableDate>

    <!-- Guru Nanak Gurpurab — commonly observed at Kartik Purnima. Strategy: OffsetFromRule, 15 days after the Diwali/Kartik new-moon calculation. -->
    <NotableDate id="guru-nanak-gurpurab" displayName="Guru Nanak Gurpurab" category="Religious" defaultNonWorkingDay="false">
      <Rules><Rule id="default">
        <Strategy><OffsetFromRule notableDateRef="bandi-chhor-divas" ruleRef="default" offsetDays="15" /></Strategy></Rule></Rules>
    </NotableDate>

    <!--
      Holi anchor — calculation anchor for Hola Mohalla only. Territory packs should import hola-mohalla rather than
      this helper concept unless they need the underlying Holi-aligned date for Sikh-specific rules.
    -->
    <NotableDate id="holi-anchor" displayName="Holi Anchor" category="Religious" defaultNonWorkingDay="false">
      <Rules><Rule id="default"><Strategy><Algorithm key="holi" /></Strategy></Rule></Rules>
    </NotableDate>

  </NotableDates>
</NotableDateResource>
