<?xml version="1.0" encoding="utf-8"?>
<!--
  French notable-date resource using the Western/Gregorian calendar.

  These entries represent French public holidays and widely observed cultural
  dates. National rules use territory="FR"; regional rules use their ISO
  subdivision territory codes.

  Country-specific rules explicitly import only the inherited global and
  Christian dates that France observes, and override naming, territory,
  nonWorking, adjustment, or tagging behaviour where required.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!--
    Imported global observances.
  -->

  <UseFrom resource="./global-all.xml">
    <Use name="New Year's Day" territory="FR" nonWorking="true" />
    <Use name="Valentine's Day" territory="FR" />
    <Use name="International Women's Day" territory="FR" />
    <Use name="April Fool's Day" territory="FR" />
  </UseFrom>

  <!--
    Imported Christian observances.
  -->

  <UseFrom resource="./christian-gregorian.xml">
    <Use name="Easter Sunday" territory="FR" />
    <Use name="Easter Monday" territory="FR" nonWorking="true" />
    <Use name="Ascension Day" territory="FR" nonWorking="true" />
    <Use name="Pentecost Sunday" territory="FR" />
    <Use name="Whit Monday" territory="FR" nonWorking="true" />
    <Use name="Christmas Eve" territory="FR" />
    <Use name="Christmas Day" territory="FR" nonWorking="true" />
  </UseFrom>

  <!--
    National French holidays and observances.
  -->

  <NotableDate name="Fête du Travail">
    <Rule name="Fixed Fête du Travail"
          category="Holiday"
          territory="FR"
          nonWorking="true"
          comment="France's International Workers' Day is locally named Fête du Travail.">
      <Fixed month="May" day="1" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Victory in Europe Day">
    <Rule name="Fixed Victory in Europe Day"
          category="Holiday"
          territory="FR"
          nonWorking="true">
      <Fixed month="May" day="8" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Bastille Day">
    <Rule name="Fixed Bastille Day"
          category="Holiday"
          territory="FR"
          nonWorking="true">
      <Fixed month="July" day="14" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Assumption of Mary">
    <Rule name="Fixed Assumption of Mary"
          category="Holiday"
          territory="FR"
          nonWorking="true">
      <Fixed month="August" day="15" />
      <Tag>Christian</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="All Saints' Day">
    <Rule name="Fixed All Saints Day"
          category="Holiday"
          territory="FR"
          nonWorking="true">
      <Fixed month="November" day="1" />
      <Tag>Christian</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Armistice Day">
    <Rule name="Fixed Armistice Day"
          category="Holiday"
          territory="FR"
          nonWorking="true">
      <Fixed month="November" day="11" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <!--
    Widely observed French cultural and family observances.
  -->

  <NotableDate name="Mother's Day">
    <Rule name="Last Sunday In May Mother's Day"
          category="Observance"
          territory="FR"
          comment="La Fête des Mères. Observed on the last Sunday in May. When the last Sunday of May coincides with Pentecost Sunday, the observance moves to the first Sunday of June by long-standing convention.">
      <DayOfWeekInMonth month="May" dayOfWeek="Sunday" weekOrdinal="Last" />
      <Tag>Approximate</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Father's Day">
    <Rule name="Third Sunday In June Father's Day"
          category="Observance"
          territory="FR">
      <DayOfWeekInMonth month="June" dayOfWeek="Sunday" weekOrdinal="Third" />
    </Rule>
  </NotableDate>

  <NotableDate name="World Music Day">
    <Rule name="Fixed World Music Day"
          category="Cultural"
          territory="FR"
          firstYear="1982"
          comment="Fête de la Musique. Launched in France by the Ministry of Culture in 1982; now celebrated worldwide on 21 June. Free public performances are held throughout France on the summer solstice.">
      <Fixed month="June" day="21" />
    </Rule>
  </NotableDate>

  <!--
    Alsace-Moselle regional holidays and observances.
  -->

  <NotableDate name="Good Friday (Alsace-Moselle)">
    <Rule name="Friday Before Western Easter Good Friday"
          category="Holiday"
          territory="FR-67,FR-68,FR-57"
          nonWorking="true">
      <OffsetFromAnchor name="Easter Sunday" offset="-2" />
      <Tag>Christian</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Saint Stephen's Day">
    <Rule name="Fixed Saint Stephen's Day"
          category="Holiday"
          territory="FR-67,FR-68,FR-57"
          nonWorking="true">
      <Fixed month="December" day="26" />
      <Tag>Christian</Tag>
    </Rule>
  </NotableDate>

</NotableDates>