<?xml version="1.0" encoding="utf-8"?>
<!--
  Default minimal notable-date resource shipped in the main library so that
  consumers calling the parameterless `new NotableDateService()` ctor receive a
  usable service without referencing any companion data pack.

  Region-specific public holidays (US Independence Day, UK Bank Holidays, etc.)
  ship in dedicated companion data assemblies (Bodu.Globalization.Calendar.Data.*)
  and are added to the service by passing the pack's CreateProvider() result to
  the full constructor's ruleProviders parameter.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <NotableDate name="New Year's Day">
    <Rule name="fixed-jan-01-weekend-roll" category="Holiday" nonWorking="true">
      <Fixed month="January" day="1" />
      <Adjustment key="weekend-roll" when="IfWeekend" action="MoveToNextWeekday" />
    </Rule>
  </NotableDate>

</NotableDates>
