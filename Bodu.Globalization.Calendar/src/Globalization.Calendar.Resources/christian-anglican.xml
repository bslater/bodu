<?xml version="1.0" encoding="utf-8"?>
<!--
  Anglican Christian notable-date catalogue (Western / Gregorian calendar)
  ================================================================================================================

  A common-library catalogue of Anglican feast days and commemorations that sit beside common.christian-western. The
  shared Western Christian catalogue already carries the Easter cluster, Epiphany, Candlemas, Annunciation, All Saints,
  Christmas, and other broadly Western feasts. This catalogue defines additional Anglican calendar concepts that are
  useful for Anglican territory, church, school, and cultural packs, without re-declaring the Western Christian base.

  Convention (matching the other common catalogues): each concept carries the bare calculation strategy under the
  stable rule id "default" with no territory scope. A territory pack imports the concept it observes through an
  <Import><Use> directive and supplies its own territory scope, category, non-working flag, and any weekend adjustment
  there. The catalogue default category is Religious; a pack that observes one as a cultural or public holiday overrides
  category/nonWorking on its own <Use>.

  The Anglican calendar is not completely uniform across provinces. This file therefore favours high-reuse fixed-date
  feast concepts and leaves province-specific ranking, optionality, and local commemorations to territory or province
  packs.
-->
<NotableDateResource xmlns="urn:bodu:globalization:calendar" schemaVersion="1.0" resourceId="common.christian-anglican">

  <NotableDates>

    <!--
      ============================================================================================================
      Principal and widely reused Anglican feasts not already carried by common.christian-western
      ============================================================================================================
    -->

    <!-- Naming and Circumcision of Jesus Christ — 1 January. Strategy: Fixed day-of-month. -->
    <NotableDate id="naming-and-circumcision-of-jesus" displayName="Naming and Circumcision of Jesus Christ" category="Religious" defaultNonWorkingDay="false">
      <Rules><Rule id="default"><Strategy><Fixed month="January" day="1" /></Strategy></Rule></Rules>
    </NotableDate>

    <!-- Baptism of Christ — Sunday after Epiphany. Strategy: WeekdayNearDate. -->
    <NotableDate id="baptism-of-christ" displayName="Baptism of Christ" category="Religious" defaultNonWorkingDay="false">
      <Rules><Rule id="default"><Strategy><WeekdayNearDate month="January" day="6" dayOfWeek="Sunday" direction="After" /></Strategy></Rule></Rules>
    </NotableDate>

    <!-- Michael and All Angels — 29 September. Strategy: Fixed day-of-month. -->
    <NotableDate id="michael-and-all-angels" displayName="Michael and All Angels" category="Religious" defaultNonWorkingDay="false">
