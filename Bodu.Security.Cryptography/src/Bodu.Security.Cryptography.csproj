<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build configuration and NuGet package metadata. -->
  <PropertyGroup>
    <TargetFrameworks>$(BoduNetTargets)</TargetFrameworks>

    <!--
      Out of band: shipped 1.2.0 ahead of the lock-step BoduBaseVersion (bld/RELEASING.md, "Out-of-band
      single-package release"), and validates against its own last release, 1.2.0, rather than the
      shared baseline. 1.2.0 needs Bodu.Core 1.0.1, whose internal vector rotations its kernels call,
      so the two shipped together. When BoduBaseVersion reaches 1.2.0, remove both properties; the
      release-manifest check fails until they are gone.
    -->
    <BoduPackageVersionOverride>1.2.0</BoduPackageVersionOverride>
    <PackageValidationBaselineVersion Condition="'$(BoduSignAssembly)' == 'true'">1.2.0</PackageValidationBaselineVersion>
    <RootNamespace>Bodu</RootNamespace>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <IsAotCompatible Condition="'$(BoduTfmIsNetCore)' == 'true'">true</IsAotCompatible>

    <!--
      Argon2's memory matrix and scrypt's V live in native memory (Argon2Matrix and ScryptCore.Workspace, reused
      through NativeBufferPool), so neither reaches the collected heap; the pointer code is confined to those three
      types. Unsafe code also enables [SkipLocalsInit] on the Argon2 and scrypt cores, whose scratch buffers are all
      written before they are read.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Title>Bodu - Cryptography</Title>
    <Description>Managed implementations of modern and legacy cryptographic primitives for .NET (block ciphers, AEAD modes, hashes/MACs, padding, transforms, the RFC 6962 Merkle tree with inclusion and consistency proofs, and asymmetric algorithms: X25519, Ed25519, and the post-quantum ML-KEM / ML-DSA). NOT independently audited, NOT FIPS-validated, and side-channel resistance is best-effort only - see the package README. Use the platform System.Security.Cryptography types where they cover your needs.</Description>
    <PackageTags>$(PackageTags);cryptography;crypto;cipher;aead;hash;mac;merkle-tree;rfc6962;ed25519;ml-kem;ml-dsa</PackageTags>
  </PropertyGroup>

  <!-- Grant the companion test project access to internal members. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Bodu.Security.Cryptography.Test</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Bodu.Security.Cryptography.Simd.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Bodu project dependencies. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Bodu.Core\src\Bodu.Core.csproj" />
  </ItemGroup>

  <!-- Strongly-typed exception and diagnostic strings (ResX + generated accessor). -->
  <ItemGroup>
    <EmbeddedResource Include="CryptoResourceStrings.resx">
      <LastGenOutput>CryptoResourceStrings.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <Compile Update="CryptoResourceStrings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CryptoResourceStrings.resx</DependentUpon>
    </Compile>
  </ItemGroup>


</Project>
