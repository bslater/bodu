    <EmbeddedResource Include="Security.Cryptography\Fixtures\Tiger\Nessie\test-vectors-nessie-format.dat" LogicalName="Bodu.Security.Cryptography.Tiger.test-vectors-nessie-format.dat" />
    <EmbeddedResource Include="Security.Cryptography\Fixtures\Tiger\Biham\biham-tiger2-vectors.txt" LogicalName="Bodu.Security.Cryptography.Tiger.biham-tiger2-vectors.txt" />
    <EmbeddedResource Include="Security.Cryptography\Fixtures\CubeHash\Sha3Round2\ShortMsgKAT_224.txt" LogicalName="Bodu.Security.Cryptography.CubeHash.ShortMsgKAT_224.txt" />
