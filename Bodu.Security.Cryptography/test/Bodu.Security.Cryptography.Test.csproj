    <EmbeddedResource Include="Security.Cryptography\Fixtures\CubeHash\Sha3Round2\ShortMsgKAT_512.txt" LogicalName="Bodu.Security.Cryptography.CubeHash.ShortMsgKAT_512.txt" />
