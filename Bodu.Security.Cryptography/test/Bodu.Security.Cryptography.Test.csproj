    <EmbeddedResource Include="Security.Cryptography\Fixtures\Blake2\Official\blake2-kat.json" LogicalName="Bodu.Security.Cryptography.Blake2.blake2-kat.json" />
    <EmbeddedResource Include="Security.Cryptography\Fixtures\Blake3\Official\test_vectors.json" LogicalName="Bodu.Security.Cryptography.Blake3.test_vectors.json" />
    <EmbeddedResource Include="Security.Cryptography\Fixtures\Whirlpool\OpenSsl\evpmd_whirlpool.txt" LogicalName="Bodu.Security.Cryptography.Whirlpool.openssl-evptests.txt" />
