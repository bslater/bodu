<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bodu</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Externally-acquired known-answer test (KAT) vector files, grouped under
    Security.Cryptography\Fixtures\<Cipher>\<Source>\ with their original upstream file names.
    LogicalName pins the embedded-resource manifest name so the on-disk layout can change
    without touching the readers/tests that call GetManifestResourceStream(...).
    See Security.Cryptography\Fixtures\README.md for provenance and shared-file notes.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Security.Cryptography\Fixtures\Ascon\NistLwc\LWC_AEAD_KAT_128_128.txt" LogicalName="Bodu.Security.Cryptography.AsconAead128.LWC_AEAD_KAT_128_128.txt" />
    <EmbeddedResource Include="Security.Cryptography\Fixtures\Ascon\NistLwc\LWC_XOF_KAT_128_512.txt" LogicalName="Bodu.Security.Cryptography.AsconXof128.LWC_XOF_KAT_128_512.txt" />
    <EmbeddedResource Include="Security.Cryptography\Fixtures\Ascon\NistLwc\LWC_CXOF_KAT_128_512.txt" LogicalName="Bodu.Security.Cryptography.AsconCxof128.LWC_CXOF_KAT_128_512.txt" />
    <EmbeddedResource Include="Security.Cryptography\Fixtures\SipHash\Veorq\vectors.h" LogicalName="Bodu.Security.Cryptography.SipHash.vectors.h" />
    <EmbeddedResource Include="Security.Cryptography\Fixtures\Snefru\Merkle\testSnefru.txt" LogicalName="Bodu.Security.Cryptography.Snefru.testSnefru.txt" />
    <EmbeddedResource Include="Security.Cryptography\Fixtures\Snefru\Merkle\correctSnefruOutput.txt" LogicalName="Bodu.Security.Cryptography.Snefru.correctSnefruOutput.txt" />
