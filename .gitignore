## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# -----------------------------
# Local NuGet feed for the in-repo Bodu.CodeStyle.XmlDocumentation analyzer.
# Restored by repo-root NuGet.config; populated by `dotnet pack Bodu.CodeStyle/Bodu.CodeStyle.XmlDocumentation/...`
# or by the CI "Pack analyzer" step.
# -----------------------------
/local-packages/

# -----------------------------
# User-specific files
# -----------------------------
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# MonoDevelop / Xamarin
*.userprefs

# Mono crash dumps
mono_crash.*

# -----------------------------
# Build outputs
# -----------------------------
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# -----------------------------
# Visual Studio
# -----------------------------
.vs/
*/.vs/

Generated\ Files/

# -----------------------------
# Test outputs
# -----------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# BenchmarkDotNet
BenchmarkDotNet.Artifacts/

# Coverlet / coverage
coverage*.json
coverage*.xml
coverage*.info

# Visual Studio coverage
*.coverage
*.coveragexml

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# -----------------------------
# .NET / NuGet
# -----------------------------
project.lock.json
project.fragment.lock.json
artifacts/

*.nupkg
*.snupkg

**/[Pp]ackages/*
!**/[Pp]ackages/build/

# -----------------------------
# Style / analysis
# -----------------------------
StyleCopReport.xml

# -----------------------------
# VS build artifacts
# -----------------------------
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.tmp
*.log

# -----------------------------
# ReSharper / tools
# -----------------------------
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

*.dotCover

# -----------------------------
# Node / Python
# -----------------------------
node_modules/
__pycache__/
*.pyc

# -----------------------------
# SQL Server
# -----------------------------
*.mdf
*.ldf
*.ndf

# -----------------------------
# MSBuild logs
# -----------------------------
*.binlog

# -----------------------------
# Visual Studio cache files
# -----------------------------

# Generic cache extensions
*.[Cc]ache

# SQLite IDE/workspace caches (safe subset)
slnx.sqlite
*.sqlite-shm
*.sqlite-wal

# Keep .cache directories if explicitly tracked
!?*.[Cc]ache/

# -----------------------------
# DocFX output
# -----------------------------
*/docs/api/**/*.yml
*/docs/api/**/.manifest
*/docs/_site/
*/docs/public/

# -----------------------------
# Local / experimental folders
# -----------------------------
/ConsoleApp2/
/bc-csharp/