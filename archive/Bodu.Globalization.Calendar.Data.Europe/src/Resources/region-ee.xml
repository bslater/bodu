<?xml version="1.0" encoding="utf-8"?>
<!--
  Estonia (EE) notable-date resource using the Western / Gregorian calendar.

  National public holidays (riigipühad). Estonia does not observe Easter Monday
  as a public holiday; Good Friday, Easter Sunday, and Whit Sunday are the
  observed movable Christian holidays.

  Common European observances are inherited from europe-common.xml and
  localized with territory="EE"; Estonia-specific holidays are declared below.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <UseFrom resource="./europe-common.xml">
    <Use name="New Year's Day" territory="EE" />
    <Use name="Easter Sunday" territory="EE" />
    <Use name="Good Friday" territory="EE" />
    <Use name="International Workers' Day" as="Spring Day" territory="EE" />
    <Use name="Pentecost Sunday" as="Whit Sunday" territory="EE" />
    <Use name="Christmas Eve" nonWorking="true" category="Holiday" territory="EE" />
    <Use name="Christmas Day" territory="EE" />
    <Use name="Boxing Day" as="Second Day of Christmas" territory="EE" />
  </UseFrom>

  <!--
    National Estonian holidays.
  -->

  <NotableDate name="Independence Day">
    <Rule name="fixed-feb-24-ee" category="Holiday" territory="EE" nonWorking="true" firstYear="1918"
          comment="Iseseisvuspäev. Marks the declaration of Estonian independence on 24 February 1918.">
      <Fixed month="February" day="24" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Victory Day">
    <Rule name="fixed-jun-23-ee" category="Holiday" territory="EE" nonWorking="true" firstYear="1919"
          comment="Võidupüha. Commemorates the Battle of Võnnu of 23 June 1919 during the Estonian War of Independence.">
      <Fixed month="June" day="23" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Midsummer Day">
    <Rule name="fixed-jun-24-ee" category="Holiday" territory="EE" nonWorking="true"
          comment="Jaanipäev. Saint John's Day, the high point of the Estonian midsummer celebration.">
      <Fixed month="June" day="24" />
      <Tag>Cultural</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Day of Restoration of Independence">
    <Rule name="fixed-aug-20-ee" category="Holiday" territory="EE" nonWorking="true" firstYear="1991"
          comment="Taasiseseisvumispäev. Marks the restoration of Estonian independence on 20 August 1991.">
      <Fixed month="August" day="20" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

</NotableDates>
