<?xml version="1.0" encoding="utf-8"?>
<!--
  Bulgaria (BG) notable-date resource.

  National public holidays (официални празници). Bulgaria celebrates Christmas
  on the Gregorian date (24–26 December) but follows the Eastern Orthodox
  calendar for the movable Easter cycle, cherry-picked from the main library's
  christian-orthodox.xml (anchored on Orthodox Easter Sunday); the fixed
  Gregorian observances come from europe-common.xml.

  Algorithm note: resolving the Orthodox movable feasts requires the
  "orthodox-easter-sunday" INotableDateAlgorithm to be registered with the
  service.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <UseFrom resource="./europe-common.xml">
    <Use name="New Year's Day" territory="BG" />
    <Use name="International Workers' Day" as="Labour Day" territory="BG" />
    <Use name="Christmas Eve" nonWorking="true" category="Holiday" territory="BG" />
    <Use name="Christmas Day" territory="BG" />
    <Use name="Boxing Day" as="Second Day of Christmas" territory="BG" />
  </UseFrom>

  <UseFrom resource="./christian-orthodox.xml">
    <Use name="Orthodox Good Friday" as="Good Friday" nonWorking="true" territory="BG" />
    <Use name="Orthodox Holy Saturday" as="Holy Saturday" category="Holiday" nonWorking="true" territory="BG" />
    <Use name="Orthodox Easter Sunday" territory="BG" />
    <Use name="Orthodox Easter Monday" nonWorking="true" territory="BG" />
  </UseFrom>

  <!--
    National Bulgarian holidays.
  -->

  <NotableDate name="Liberation Day">
    <Rule name="fixed-mar-03-bg" category="Holiday" territory="BG" nonWorking="true" firstYear="1878"
          comment="Ден на Освобождението. National day marking the liberation from Ottoman rule under the Treaty of San Stefano of 3 March 1878.">
      <Fixed month="March" day="3" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Saint George's Day">
    <Rule name="fixed-may-06-bg" category="Holiday" territory="BG" nonWorking="true"
          comment="Гергьовден, Ден на храбростта. Day of Valour and the Bulgarian Army, honoring Saint George on 6 May.">
      <Fixed month="May" day="6" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Bulgarian Education and Culture and Slavonic Literature Day">
    <Rule name="fixed-may-24-bg" category="Holiday" territory="BG" nonWorking="true"
          comment="Ден на българската просвета и култура и на славянската писменост. Honors Saints Cyril and Methodius and the Cyrillic alphabet on 24 May.">
      <Fixed month="May" day="24" />
      <Tag>Cultural</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Unification Day">
    <Rule name="fixed-sep-06-bg" category="Holiday" territory="BG" nonWorking="true" firstYear="1885"
          comment="Ден на Съединението. Marks the unification of the Principality of Bulgaria with Eastern Rumelia in 1885.">
      <Fixed month="September" day="6" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Independence Day">
    <Rule name="fixed-sep-22-bg" category="Holiday" territory="BG" nonWorking="true" firstYear="1908"
          comment="Ден на Независимостта. Marks Bulgaria's declaration of full independence from the Ottoman Empire in 1908.">
      <Fixed month="September" day="22" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

</NotableDates>
