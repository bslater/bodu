<?xml version="1.0" encoding="utf-8"?>
<!--
  Denmark (DK) notable-date resource using the Western / Gregorian calendar.

  Public holidays (helligdage). Great Prayer Day (Store Bededag) was abolished
  as a public holiday with effect from 2024 and is not modelled. Maundy
  Thursday is observed in Denmark and is declared locally, since it is not part
  of the pan-European common set. Constitution Day is a partial holiday and is
  modelled as a recognition-only observance.

  Common European observances are inherited from europe-common.xml and
  localized with territory="DK"; Denmark-specific holidays are declared below.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <UseFrom resource="./europe-common.xml">
    <Use name="New Year's Day" territory="DK" />
    <Use name="Easter Sunday" territory="DK" />
    <Use name="Good Friday" territory="DK" />
    <Use name="Easter Monday" territory="DK" />
    <Use name="Ascension Day" territory="DK" />
    <Use name="Pentecost Sunday" as="Whit Sunday" territory="DK" />
    <Use name="Whit Monday" territory="DK" />
    <Use name="Christmas Day" territory="DK" />
    <Use name="Boxing Day" as="Second Day of Christmas" territory="DK" />
  </UseFrom>

  <!--
    National Danish holidays and observances. Maundy Thursday derives from the
    inherited "Easter Sunday" anchor cherry-picked above.
  -->

  <NotableDate name="Maundy Thursday">
    <Rule name="offset-easter-sunday-3-dk" category="Holiday" territory="DK" nonWorking="true" firstYear="1583"
          comment="Skærtorsdag. Public holiday in Denmark, the Thursday before Easter.">
      <OffsetFromAnchor name="Easter Sunday" offset="-3" />
      <Tag>Christian</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Constitution Day">
    <Rule name="fixed-jun-05-dk" category="Observance" territory="DK" firstYear="1849"
          comment="Grundlovsdag. Marks the signing of the first Danish constitution on 5 June 1849. A partial holiday; many workplaces close from midday but it is not a statutory public holiday.">
      <Fixed month="June" day="5" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

</NotableDates>
