<?xml version="1.0" encoding="utf-8"?>
<!--
  Ireland (IE) notable-date resource using the Western / Gregorian calendar.

  Public holidays of the Republic of Ireland. Most of Ireland's public
  holidays fall on a Monday by rule; the fixed-date holidays (New Year's Day,
  Saint Patrick's Day, Christmas Day, Saint Stephen's Day) roll to the next
  available weekday when they fall on a weekend.

  Common European observances are inherited from europe-common.xml and
  localized with territory="IE"; Ireland-specific holidays are declared below.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <UseFrom resource="./europe-common.xml">
    <Use name="New Year's Day" territory="IE">
      <Rule name="fixed-jan-01-ie" category="Holiday">
        <Adjustment key="weekend-roll" when="IfWeekend" action="MoveToNextWeekday" />
      </Rule>
    </Use>
    <Use name="Easter Sunday" territory="IE" />
    <Use name="Easter Monday" territory="IE" />
    <Use name="Christmas Day" territory="IE">
      <Rule name="fixed-dec-25-ie" category="Holiday">
        <Adjustment key="weekend-roll" when="IfWeekend" action="MoveToNextWeekday" />
      </Rule>
    </Use>
    <Use name="Boxing Day" as="Saint Stephen's Day" territory="IE">
      <Rule name="fixed-dec-26-ie" category="Holiday">
        <Adjustment key="weekend-roll" when="IfWeekend" action="MoveToNextWeekday" />
      </Rule>
    </Use>
  </UseFrom>

  <!--
    National Irish public holidays.
  -->

  <NotableDate name="Saint Brigid's Day">
    <Rule name="weekday-1st-mon-feb-ie" category="Holiday" territory="IE" nonWorking="true" firstYear="2023"
          comment="Lá Fhéile Bríde. Ireland's newest public holiday, first observed in 2023. Celebrated on the first Monday in February, except when 1 February falls on a Friday, in which case the holiday is that Friday; the Friday exception is not resolved automatically by this rule.">
      <DayOfWeekInMonth month="February" dayOfWeek="Monday" weekOrdinal="First" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Saint Patrick's Day">
    <Rule name="fixed-mar-17-ie" category="Holiday" territory="IE" nonWorking="true"
          comment="Lá Fhéile Pádraig. National day of Ireland, honoring its patron saint on the traditional date of his death (17 March, c. 461 AD).">
      <Fixed month="March" day="17" />
      <Tag>National</Tag>
      <Adjustment key="weekend-roll" when="IfWeekend" action="MoveToNextWeekday" />
    </Rule>
  </NotableDate>

  <NotableDate name="May Day">
    <Rule name="weekday-1st-mon-may-ie" category="Holiday" territory="IE" nonWorking="true">
      <DayOfWeekInMonth month="May" dayOfWeek="Monday" weekOrdinal="First" />
      <Tag>BankHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="June Bank Holiday">
    <Rule name="weekday-1st-mon-jun-ie" category="Holiday" territory="IE" nonWorking="true">
      <DayOfWeekInMonth month="June" dayOfWeek="Monday" weekOrdinal="First" />
      <Tag>BankHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="August Bank Holiday">
    <Rule name="weekday-1st-mon-aug-ie" category="Holiday" territory="IE" nonWorking="true">
      <DayOfWeekInMonth month="August" dayOfWeek="Monday" weekOrdinal="First" />
      <Tag>BankHoliday</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="October Bank Holiday">
    <Rule name="weekday-last-mon-oct-ie" category="Holiday" territory="IE" nonWorking="true">
      <DayOfWeekInMonth month="October" dayOfWeek="Monday" weekOrdinal="Last" />
      <Tag>BankHoliday</Tag>
    </Rule>
  </NotableDate>

</NotableDates>
