<?xml version="1.0" encoding="utf-8"?>
<!--
  Greece (GR) notable-date resource.

  National public holidays. Greece follows the Eastern Orthodox liturgical
  calendar for movable feasts, so the Easter cycle is cherry-picked from the
  main library's christian-orthodox.xml (anchored on Orthodox Easter Sunday),
  while the fixed Gregorian observances (New Year, Epiphany, Labour Day,
  Assumption, Christmas) come from europe-common.xml.

  Algorithm note: resolving the Orthodox movable feasts requires the
  "orthodox-easter-sunday" INotableDateAlgorithm to be registered with the
  service.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!--
    Fixed Gregorian common observances.
  -->

  <UseFrom resource="./europe-common.xml">
    <Use name="New Year's Day" territory="GR" />
    <Use name="Epiphany" territory="GR" />
    <Use name="International Workers' Day" as="Labour Day" territory="GR" />
    <Use name="Assumption of Mary" as="Dormition of the Mother of God" territory="GR" />
    <Use name="Christmas Day" territory="GR" />
    <Use name="Boxing Day" as="Synaxis of the Mother of God" territory="GR" />
  </UseFrom>

  <!--
    Movable Orthodox Easter cycle.
  -->

  <UseFrom resource="./christian-orthodox.xml">
    <Use name="Orthodox Clean Monday" category="Holiday" nonWorking="true" territory="GR" />
    <Use name="Orthodox Good Friday" nonWorking="true" territory="GR" />
    <Use name="Orthodox Holy Saturday" category="Holiday" nonWorking="true" territory="GR" />
    <Use name="Orthodox Easter Sunday" territory="GR" />
    <Use name="Orthodox Easter Monday" nonWorking="true" territory="GR" />
    <Use name="Orthodox Pentecost Monday" as="Holy Spirit Monday" category="Holiday" nonWorking="true" territory="GR" />
  </UseFrom>

  <!--
    National Greek holidays.
  -->

  <NotableDate name="Independence Day">
    <Rule name="fixed-mar-25-gr" category="Holiday" territory="GR" nonWorking="true" firstYear="1821"
          comment="Marks the start of the Greek War of Independence on 25 March 1821; coincides with the Annunciation.">
      <Fixed month="March" day="25" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Ochi Day">
    <Rule name="fixed-oct-28-gr" category="Holiday" territory="GR" nonWorking="true" firstYear="1940"
          comment="Επέτειος του Όχι. Commemorates Greece's rejection of the Italian ultimatum of 28 October 1940 and its entry into the Second World War.">
      <Fixed month="October" day="28" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

</NotableDates>
