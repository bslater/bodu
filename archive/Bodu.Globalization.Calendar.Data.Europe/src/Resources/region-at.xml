<?xml version="1.0" encoding="utf-8"?>
<!--
  Austria (AT) notable-date resource using the Western / Gregorian calendar.

  National public holidays (gesetzliche Feiertage), observed in all nine
  federal states. Good Friday is a paid holiday only for members of specific
  Protestant churches and is therefore not modelled as a national holiday.

  Common European observances are inherited from europe-common.xml and
  localized with territory="AT"; Austria-specific holidays are declared below.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <UseFrom resource="./europe-common.xml">
    <Use name="New Year's Day" territory="AT" />
    <Use name="Epiphany" territory="AT" />
    <Use name="Easter Sunday" territory="AT" />
    <Use name="Easter Monday" territory="AT" />
    <Use name="International Workers' Day" as="State Holiday" territory="AT" />
    <Use name="Ascension Day" territory="AT" />
    <Use name="Whit Monday" territory="AT" />
    <Use name="Corpus Christi" territory="AT" />
    <Use name="Assumption of Mary" territory="AT" />
    <Use name="All Saints' Day" territory="AT" />
    <Use name="Immaculate Conception" territory="AT" />
    <Use name="Christmas Day" territory="AT" />
    <Use name="Boxing Day" as="Saint Stephen's Day" territory="AT" />
  </UseFrom>

  <!--
    National Austrian holidays.
  -->

  <NotableDate name="National Day">
    <Rule name="fixed-oct-26-at" category="Holiday" territory="AT" nonWorking="true" firstYear="1965"
          comment="Nationalfeiertag. Commemorates the Declaration of Neutrality passed on 26 October 1955, the day after the last Allied occupation troops left Austria.">
      <Fixed month="October" day="26" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

</NotableDates>
