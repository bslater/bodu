<?xml version="1.0" encoding="utf-8"?>
<!--
  Lithuania (LT) notable-date resource using the Western / Gregorian calendar.

  National public holidays (valstybės šventės ir nedarbo dienos).

  Common European observances are inherited from europe-common.xml and
  localized with territory="LT"; Lithuania-specific holidays are declared below.
-->
<NotableDates xmlns="urn:bodu:globalization:calendar"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <UseFrom resource="./europe-common.xml">
    <Use name="New Year's Day" territory="LT" />
    <Use name="Easter Sunday" territory="LT" />
    <Use name="Easter Monday" territory="LT" />
    <Use name="International Workers' Day" as="Labour Day" territory="LT" />
    <Use name="Assumption of Mary" territory="LT" />
    <Use name="All Saints' Day" territory="LT" />
    <Use name="All Souls' Day" nonWorking="true" category="Holiday" territory="LT" />
    <Use name="Christmas Eve" nonWorking="true" category="Holiday" territory="LT" />
    <Use name="Christmas Day" territory="LT" />
    <Use name="Boxing Day" as="Second Day of Christmas" territory="LT" />
  </UseFrom>

  <!--
    National Lithuanian holidays.
  -->

  <NotableDate name="Day of Restoration of the State">
    <Rule name="fixed-feb-16-lt" category="Holiday" territory="LT" nonWorking="true" firstYear="1918"
          comment="Lietuvos valstybės atkūrimo diena. Marks the Act of Independence of 16 February 1918, re-establishing the Lithuanian state.">
      <Fixed month="February" day="16" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Day of Restoration of Independence">
    <Rule name="fixed-mar-11-lt" category="Holiday" territory="LT" nonWorking="true" firstYear="1990"
          comment="Lietuvos nepriklausomybės atkūrimo diena. Marks the Act of the Re-Establishment of the State of Lithuania of 11 March 1990, the first Soviet republic to declare independence.">
      <Fixed month="March" day="11" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Saint John's Day">
    <Rule name="fixed-jun-24-lt" category="Holiday" territory="LT" nonWorking="true"
          comment="Joninės (Rasos). Midsummer celebration on 24 June, blending the feast of the Nativity of Saint John the Baptist with pre-Christian solstice traditions.">
      <Fixed month="June" day="24" />
      <Tag>Cultural</Tag>
    </Rule>
  </NotableDate>

  <NotableDate name="Statehood Day">
    <Rule name="fixed-jul-06-lt" category="Holiday" territory="LT" nonWorking="true" firstYear="1253"
          comment="Valstybės diena. Commemorates the coronation of Mindaugas as the only King of Lithuania on 6 July 1253.">
      <Fixed month="July" day="6" />
      <Tag>National</Tag>
    </Rule>
  </NotableDate>

</NotableDates>
