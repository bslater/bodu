<Project>

  <!--
    Centralised analyzer package references.  Directory.Build.targets is processed
    after each project file, so $(IsTestProject) and $(GenerateDocumentationFile)
    are both fully resolved by the time these ItemGroups are evaluated.

    Distribution:
      Source projects (GenerateDocumentationFile=true, non-test)
        AsyncFixer, Microsoft.CodeAnalysis.Analyzers, Microsoft.CodeAnalysis.NetAnalyzers,
        Microsoft.VisualStudio.Threading.Analyzers, Roslynator.Analyzers, StyleCop.Analyzers
      Test projects (IsTestProject=true)
        MSTest.Analyzers
      All projects
        Roslynator.Formatting.Analyzers

    Plugin test assemblies and the docs project set GenerateDocumentationFile=false,
    which excludes them from the full analyzer stack intentionally.
  -->

  <!-- Full analyzer stack for production source projects. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true' and '$(GenerateDocumentationFile)' == 'true'">
    <PackageReference Include="AsyncFixer" Version="2.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.203">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- MSTest analyzers for test projects only. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="MSTest.Analyzers" Version="4.2.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Formatting analyzers applied to all projects. -->
  <ItemGroup>
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
