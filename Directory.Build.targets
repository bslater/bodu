<Project>

  <!--
    Define BODU_EXTENSION_MEMBERS when the building SDK is .NET 10 or later, which ships the C# 14
    compiler that supports extension members. Combined with LangVersion=latest (bld/Bodu.props), this
    lets sources express convenience members as C# 14 extension properties; older SDKs fall back to
    classic this-parameter extension methods. This lives in Directory.Build.targets rather than
    bld/Bodu.props because NETCoreSdkVersion — the SDK/Roslyn version actually running the build, and
    the correct signal for language-feature availability — is not yet set when Directory.Build.props
    imports bld/Bodu.props. VersionGreaterThanOrEquals avoids the lexical trap where "10.0" sorts
    before "8.0".

    The symbol is additionally suppressed when BuildingForDocfx=true (set by docs/docfx.json metadata
    properties). DocFX 2.78.5 cannot model C# 14 extension blocks: it hashes each extension(Receiver)
    block by receiver type, so members split one-per-partial-file collapse to a single UID and emit
    "duplicated member" warnings that fail the docfx warnings-as-errors build. Compiling the
    extension-method fallback for documentation yields the same members in a form DocFX renders cleanly
    (as Bodu.Core's DateTimeExtensions already does); the shipped library still compiles the properties.
  -->
  <PropertyGroup Condition="'$(NETCoreSdkVersion)' != '' and '$([MSBuild]::VersionGreaterThanOrEquals($(NETCoreSdkVersion), 10.0))' == 'true' and '$(BuildingForDocfx)' != 'true'">
    <DefineConstants>$(DefineConstants);BODU_EXTENSION_MEMBERS</DefineConstants>
  </PropertyGroup>

  <!--
    Centralised analyser package references. Directory.Build.targets is processed after each
    project file, so $(IsTestProject), $(GenerateDocumentationFile), and any project-specific
    opt-out properties are resolved by the time these ItemGroups are evaluated.

    Distribution:
      Source projects (BoduEnableFullAnalyzers=true)
        AsyncFixer, Microsoft.VisualStudio.Threading.Analyzers, Roslynator.Analyzers,
        StyleCop.Analyzers
      Test projects (IsTestProject=true)
        MSTest.Analyzers
      All projects
        Roslynator.Formatting.Analyzers

    The .NET SDK analysers are enabled in Directory.Build.props through EnableNETAnalyzers and
    AnalysisLevel. Microsoft.CodeAnalysis.NetAnalyzers is intentionally not referenced here so
    the SDK owns CAxxxx rule delivery. Microsoft.CodeAnalysis.Analyzers is also intentionally
    omitted because it targets Roslyn analyser/code-fix authors, not normal source projects.
  -->

  <PropertyGroup>
    <!--
      Default full analyser coverage to documented, non-test source projects. Projects can opt
      in or out explicitly by setting BoduEnableFullAnalyzers in the project file.
    -->
    <BoduEnableFullAnalyzers Condition="'$(BoduEnableFullAnalyzers)' == '' and '$(IsTestProject)' != 'true' and '$(GenerateDocumentationFile)' == 'true'">true</BoduEnableFullAnalyzers>
    <BoduEnableFullAnalyzers Condition="'$(BoduEnableFullAnalyzers)' == ''">false</BoduEnableFullAnalyzers>
  </PropertyGroup>

  <!-- Full analyser stack for production source projects. -->
  <ItemGroup Condition="'$(BoduEnableFullAnalyzers)' == 'true'">
    <PackageReference Include="AsyncFixer" Version="2.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- MSTest analysers for test projects only. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="MSTest.Analyzers" Version="4.2.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Common test harness for every test project: the MSTest framework/adapter, the test SDK, the
    coverage collector, and the project-wide MSTest using. Centralised here (rather than repeated in
    each test csproj) and gated on IsTestProject, which test projects set in their body before this
    targets file is evaluated. The Bodu.CodeStyle subtree opts out via BoduManagedTestDependencies so
    it can keep its own (older, Roslyn-compatible) pins.
  -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true' and '$(BoduManagedTestDependencies)' != 'false'">
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.1" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <!-- Formatting analysers applied to all projects. -->
  <ItemGroup>
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
