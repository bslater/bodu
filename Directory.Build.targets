<Project>

  <!--
    Centralised analyser package references. Directory.Build.targets is processed after each
    project file, so $(IsTestProject), $(GenerateDocumentationFile), and any project-specific
    opt-out properties are resolved by the time these ItemGroups are evaluated.

    Distribution:
      Source projects (BoduEnableFullAnalyzers=true)
        AsyncFixer, Microsoft.VisualStudio.Threading.Analyzers, Roslynator.Analyzers,
        StyleCop.Analyzers
      Test projects (IsTestProject=true)
        MSTest.Analyzers
      All projects
        Roslynator.Formatting.Analyzers

    The .NET SDK analysers are enabled in Directory.Build.props through EnableNETAnalyzers and
    AnalysisLevel. Microsoft.CodeAnalysis.NetAnalyzers is intentionally not referenced here so
    the SDK owns CAxxxx rule delivery. Microsoft.CodeAnalysis.Analyzers is also intentionally
    omitted because it targets Roslyn analyser/code-fix authors, not normal source projects.
  -->

  <PropertyGroup>
    <!--
      Default full analyser coverage to documented, non-test source projects. Projects can opt
      in or out explicitly by setting BoduEnableFullAnalyzers in the project file.
    -->
    <BoduEnableFullAnalyzers Condition="'$(BoduEnableFullAnalyzers)' == '' and '$(IsTestProject)' != 'true' and '$(GenerateDocumentationFile)' == 'true'">true</BoduEnableFullAnalyzers>
    <BoduEnableFullAnalyzers Condition="'$(BoduEnableFullAnalyzers)' == ''">false</BoduEnableFullAnalyzers>
  </PropertyGroup>

  <!-- Full analyser stack for production source projects. -->
  <ItemGroup Condition="'$(BoduEnableFullAnalyzers)' == 'true'">
    <PackageReference Include="AsyncFixer" Version="2.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- MSTest analysers for test projects only. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="MSTest.Analyzers" Version="4.2.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Formatting analysers applied to all projects. -->
  <ItemGroup>
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
